-void llama_file::seek(size_t offset, int whence) const { pimpl->seek(offset, whence); }
-void llama_file::read_raw(void * ptr, size_t len) { pimpl->read_raw(ptr, len); }
+void llama_file::seek(size_t offset, int whence) const {
+    if (!reader) {
+        pimpl->seek(offset, whence);
+        return;
+    }
+    if (whence != SEEK_SET && whence != SEEK_CUR && whence != SEEK_END) {
+        throw std::runtime_error("invalid reader seek origin");
+    }
+    const size_t base = whence == SEEK_SET ? 0 : whence == SEEK_CUR ? reader_offset : size();
+    if (offset > size() - base) {
+        throw std::runtime_error("model reader seek out of bounds");
+    }
+    reader_offset = base + offset;
+}
+
+void llama_file::read_raw(void * ptr, size_t len) {
+    if (!reader) {
+        pimpl->read_raw(ptr, len);
+        return;
+    }
+    if (len > size() - reader_offset || (len && reader->read(reader->userdata, ptr, reader_offset, len) != len)) {
+        throw std::runtime_error("model reader failed or returned a short read");
+    }
+    reader_offset += len;
+}
