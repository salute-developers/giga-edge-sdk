+// llama_model_load_from_reader: the same model as from the file (parameters, vocabulary, bitwise logits),
+// no reads after the load, and clean failures: invalid reader, short read in the header and in the middle
+// of a tensor, cancellation through progress_callback. Runs with n_gpu_layers 0 and 999.
+//
+// usage: test-model-reader <model.gguf> [--vocab-only]
+
+#include "llama.h"
+#include "ggml-backend.h"
+
+#include <cstdint>
