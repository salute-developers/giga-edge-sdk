+#include <memory>
+#include <stdexcept>
+#include <vector>
+
+#define CHECK(condition) do { if (!(condition)) throw std::runtime_error("check failed: " #condition); } while (false)
+
+struct source {
+    const std::vector<char> & bytes;
+    size_t fail_at         = std::numeric_limits<size_t>::max(); // reads past this offset return 0
+    bool   closed          = false;                              // every read returns 0 and is counted
+    bool   saw_tensor_read = false;                              // a read longer than a GGUF header chunk
+    size_t calls           = 0;
+};
+
+static size_t read_source(void * userdata, void * output, uint64_t offset, size_t length) {
+    auto & s = *static_cast<source *>(userdata);
+    ++s.calls;
+    s.saw_tensor_read |= length > 64 * 1024;
+    if (s.closed || offset > s.bytes.size() || length > s.bytes.size() - offset ||
+            offset > s.fail_at || length > s.fail_at - offset) {
+        return 0;
+    }
+    std::memcpy(output, s.bytes.data() + offset, length);
+    return length;
+}
+
+using model_ptr   = std::unique_ptr<llama_model,   decltype(&llama_model_free)>;
+using context_ptr = std::unique_ptr<llama_context, decltype(&llama_free)>;
+
+static void run(const char * path, const std::vector<char> & bytes, int gpu_layers, bool vocab_only) {
+    auto params = llama_model_default_params();
+    params.n_gpu_layers      = gpu_layers;
+    params.vocab_only        = vocab_only;
+    params.load_mode         = LLAMA_LOAD_MODE_NONE;
+    params.progress_callback = [](float, void *) { return true; };
+
+    // invalid readers
+    CHECK(llama_model_load_from_reader(nullptr, params) == nullptr);
+    const llama_model_reader no_read{nullptr, nullptr, bytes.size()};
+    CHECK(llama_model_load_from_reader(&no_read, params) == nullptr);
+
+    source src{bytes};
+    llama_model_reader reader{read_source, &src, bytes.size()};
+    const llama_model_reader no_size{read_source, &src, 0};
+    CHECK(llama_model_load_from_reader(&no_size, params) == nullptr);
+
+    model_ptr model(llama_model_load_from_reader(&reader, params), llama_model_free);
+    CHECK(model != nullptr);
+    CHECK(vocab_only || src.saw_tensor_read);
+
+    // the reader is not touched after the load: from here every read would fail
+    src.closed = true;
+    const size_t calls_after_load = src.calls;
+
+    model_ptr plain(llama_model_load_from_file(path, params), llama_model_free);
+    CHECK(plain != nullptr);
+    CHECK(llama_model_n_params(model.get()) == llama_model_n_params(plain.get()));
+    CHECK(llama_model_n_embd(model.get())   == llama_model_n_embd(plain.get()));
+    CHECK(llama_vocab_n_tokens(llama_model_get_vocab(model.get())) ==
+          llama_vocab_n_tokens(llama_model_get_vocab(plain.get())));
+
+    if (!vocab_only) {
+        auto cparams = llama_context_default_params();
+        cparams.n_ctx           = 32;
+        cparams.n_batch         = 1;
+        cparams.n_threads       = 1;
+        cparams.n_threads_batch = 1;
+        context_ptr ctx_reader(llama_init_from_model(model.get(), cparams), llama_free);
+        context_ptr ctx_plain (llama_init_from_model(plain.get(), cparams), llama_free);
+        CHECK(ctx_reader && ctx_plain);
+
+        llama_token token = 1;
+        CHECK(llama_decode(ctx_reader.get(), llama_batch_get_one(&token, 1)) == 0);
+        CHECK(llama_decode(ctx_plain.get(),  llama_batch_get_one(&token, 1)) == 0);
+        const size_t n_vocab = llama_vocab_n_tokens(llama_model_get_vocab(model.get()));
+        CHECK(std::memcmp(llama_get_logits(ctx_reader.get()), llama_get_logits(ctx_plain.get()), n_vocab * sizeof(float)) == 0);
+    }
+    CHECK(src.calls == calls_after_load);
+
+    // short read in the header
+    source header_failure{bytes, 0};
+    reader.userdata = &header_failure;
+    CHECK(llama_model_load_from_reader(&reader, params) == nullptr);
+
+    if (!vocab_only) {
+        // short read in the middle of the tensor data; repeated, so that leaked upload resources would pile up
+        for (int attempt = 0; attempt < 3; ++attempt) {
+            source tensor_failure{bytes, bytes.size() / 2};
+            reader.userdata = &tensor_failure;
+            CHECK(llama_model_load_from_reader(&reader, params) == nullptr);
+            CHECK(tensor_failure.saw_tensor_read);
+        }
+
+        // cancellation through the progress callback
+        source cancellation{bytes};
+        reader.userdata = &cancellation;
+        params.progress_callback = [](float progress, void *) { return progress < 0.05f; };
+        CHECK(llama_model_load_from_reader(&reader, params) == nullptr);
+        CHECK(cancellation.calls > 0);
+    }
+
+    std::printf("PASS n_gpu_layers=%d vocab_only=%d\n", gpu_layers, vocab_only);
+}
+
+int main(int argc, char ** argv) {
+    try {
+        CHECK(argc == 2 || (argc == 3 && std::strcmp(argv[2], "--vocab-only") == 0));
+        const bool vocab_only = argc == 3;
+
+        llama_log_set([](ggml_log_level, const char *, void *) {}, nullptr);
+        ggml_backend_load_all();
+        llama_backend_init();
+
+        std::ifstream file(argv[1], std::ios::binary);
+        const std::vector<char> bytes{std::istreambuf_iterator<char>(file), std::istreambuf_iterator<char>()};
+        CHECK(!bytes.empty());
+
+        for (const int gpu_layers : {0, 999}) {
+            if (vocab_only && gpu_layers != 0) {
+                continue;
+            }
+            run(argv[1], bytes, gpu_layers, vocab_only);
+        }
+
+        llama_backend_free();
+        return 0;
+    } catch (const std::exception & e) {
+        std::fprintf(stderr, "%s\n", e.what());
+        return 1;
+    }
+}
