diff --git a/tests/test-mtp-rope-factors.cpp b/tests/test-mtp-rope-factors.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..70cbaa5bfad84c16b70fd54e49095c1c9449bfa8
--- /dev/null
+++ b/tests/test-mtp-rope-factors.cpp
@@ -0,0 +1,175 @@
+// Fused MTP of a Qwen3 model with rope_freqs: the MTP blocks must rotate with the same frequencies as the main
+// layers. rope_freqs = 2.0 for every dimension is the same rotation as freq_scale = 0.5 (both are exact powers
+// of two), so a model with the tensor and the same model without it, run with freq_scale = 0.5, must give the
+// same logits and the same MTP drafts bit for bit.
+
+#include "llama.h"
+#include "ggml.h"
+#include "gguf.h"
+
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <random>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+#define CHECK(condition) do { if (!(condition)) throw std::runtime_error("check failed: " #condition); } while (false)
+
+static const int64_t n_vocab = 64, n_embd = 64, n_head = 4, n_head_kv = 2, n_ff = 128, n_layer = 2, n_nextn = 1;
+static const int64_t n_head_dim = n_embd / n_head;
+static const int     n_drafts   = 1;
+
+static void write_model(const std::string & path, bool rope_freqs) {
+    gguf_context * gguf = gguf_init_empty();
+    gguf_set_val_str(gguf, "general.architecture", "qwen3");
+    gguf_set_val_str(gguf, "tokenizer.ggml.model", "no_vocab");
+    gguf_set_val_u32(gguf, "qwen3.vocab_size",                      n_vocab);
+    gguf_set_val_u32(gguf, "qwen3.context_length",                  256);
+    gguf_set_val_u32(gguf, "qwen3.embedding_length",                n_embd);
+    gguf_set_val_u32(gguf, "qwen3.feed_forward_length",             n_ff);
+    gguf_set_val_u32(gguf, "qwen3.block_count",                     n_layer + n_nextn);
+    gguf_set_val_u32(gguf, "qwen3.nextn_predict_layers",            n_nextn);
+    gguf_set_val_u32(gguf, "qwen3.attention.head_count",            n_head);
+    gguf_set_val_u32(gguf, "qwen3.attention.head_count_kv",         n_head_kv);
+    gguf_set_val_f32(gguf, "qwen3.attention.layer_norm_rms_epsilon", 1e-6f);
+    gguf_set_val_f32(gguf, "qwen3.rope.freq_base",                  10000.0f);
+
+    ggml_init_params params = { 64 * 1024 * 1024, nullptr, false };
+    ggml_context * ctx = ggml_init(params);
+    std::mt19937 rng(7);
+    std::normal_distribution<float> dist(0.0f, 0.3f);
+    auto add = [&](const std::string & name, std::vector<int64_t> ne, float fill = 0.0f) {
+        ggml_tensor * t = ne.size() == 1 ? ggml_new_tensor_1d(ctx, GGML_TYPE_F32, ne[0])
+                                         : ggml_new_tensor_2d(ctx, GGML_TYPE_F32, ne[0], ne[1]);
+        ggml_set_name(t, name.c_str());
+        float * data = (float *) t->data;
+        for (int64_t i = 0; i < ggml_nelements(t); ++i) {
+            data[i] = fill != 0.0f ? fill : dist(rng);
+        }
+        gguf_add_tensor(gguf, t);
+    };
+
+    add("token_embd.weight",  {n_embd, n_vocab});
+    add("output_norm.weight", {n_embd}, 1.0f);
+    if (rope_freqs) {
+        add("rope_freqs.weight", {n_head_dim / 2}, 2.0f);
+    }
+    for (int il = 0; il < n_layer + n_nextn; ++il) {
+        const std::string p = "blk." + std::to_string(il) + ".";
+        add(p + "attn_norm.weight",   {n_embd}, 1.0f);
+        add(p + "attn_q.weight",      {n_embd, n_head * n_head_dim});
+        add(p + "attn_k.weight",      {n_embd, n_head_kv * n_head_dim});
+        add(p + "attn_v.weight",      {n_embd, n_head_kv * n_head_dim});
+        add(p + "attn_output.weight", {n_head * n_head_dim, n_embd});
+        add(p + "attn_q_norm.weight", {n_head_dim}, 1.0f);
+        add(p + "attn_k_norm.weight", {n_head_dim}, 1.0f);
+        add(p + "ffn_norm.weight",    {n_embd}, 1.0f);
+        add(p + "ffn_gate.weight",    {n_embd, n_ff});
+        add(p + "ffn_down.weight",    {n_ff, n_embd});
+        add(p + "ffn_up.weight",      {n_embd, n_ff});
+        if (il >= n_layer) {
+            add(p + "nextn.eh_proj.weight",          {2 * n_embd, n_embd});
+            add(p + "nextn.enorm.weight",            {n_embd}, 1.0f);
+            add(p + "nextn.hnorm.weight",            {n_embd}, 1.0f);
+            add(p + "nextn.shared_head_norm.weight", {n_embd}, 1.0f);
+        }
+    }
+
+    CHECK(gguf_write_to_file(gguf, path.c_str(), false));
+    gguf_free(gguf);
+    ggml_free(ctx);
+}
+
+// greedy generation: the logits of every step and the MTP drafts of every step
+static void run(const std::string & path, float freq_scale, std::vector<float> & logits, std::vector<llama_token> & drafts) {
+    auto mparams = llama_model_default_params();
+    mparams.load_mtp = true;
+    llama_model * model = llama_model_load_from_file(path.c_str(), mparams);
+    CHECK(model != nullptr);
+
+    auto cparams = llama_context_default_params();
+    cparams.n_ctx           = 128;
+    cparams.n_batch         = 32;
+    cparams.n_ubatch        = 32;
+    cparams.n_seq_max       = 1;
+    cparams.n_threads       = 2;
+    cparams.n_threads_batch = 2;
+    cparams.flash_attn_type = LLAMA_FLASH_ATTN_TYPE_ENABLED;
+    cparams.rope_freq_scale = freq_scale;
+    llama_context * ctx = llama_init_from_model(model, cparams);
+    CHECK(ctx != nullptr);
+    llama_set_mtp_fused(ctx, n_drafts);
+    CHECK(llama_get_mtp_fused(ctx) == n_drafts);
+
+    std::vector<llama_token> cur;
+    for (int i = 0; i < 16; ++i) {
+        cur.push_back((5 * i + 1) % n_vocab);
+    }
+    llama_pos pos = 0;
+    llama_batch batch = llama_batch_init(32, 0, 1);
+    for (int step = 0; step < 24; ++step) {
+        batch.n_tokens = 0;
+        for (size_t i = 0; i < cur.size(); ++i) {
+            batch.token[i] = cur[i]; batch.pos[i] = pos + i; batch.n_seq_id[i] = 1; batch.seq_id[i][0] = 0;
+            batch.logits[i] = i + 1 == cur.size();
+            batch.n_tokens++;
+        }
+        CHECK(llama_decode(ctx, batch) == 0);
+        pos += cur.size();
+
+        const float * l = llama_get_logits_ith(ctx, -1);
+        logits.insert(logits.end(), l, l + n_vocab);
+        llama_token best = 0;
+        for (int t = 1; t < n_vocab; ++t) {
+            if (l[t] > l[best]) {
+                best = t;
+            }
+        }
+        llama_token d[n_drafts];
+        const int32_t n = llama_get_mtp_drafts_ith(ctx, -1, d, n_drafts);
+        CHECK(n == n_drafts);
+        drafts.insert(drafts.end(), d, d + n);
+        cur = { best };
+    }
+    llama_batch_free(batch);
+    llama_free(ctx);
+    llama_model_free(model);
+}
+
+int main() {
+    try {
+        llama_log_set([](ggml_log_level, const char *, void *) {}, nullptr);
+        llama_backend_init();
+
+        const std::string with_freqs = "test-mtp-rope-freqs.gguf", without = "test-mtp-rope-plain.gguf";
+        write_model(with_freqs, true);
+        write_model(without,    false);
+
+        std::vector<float> logits_a, logits_b;
+        std::vector<llama_token> drafts_a, drafts_b;
+        run(with_freqs, 0.0f, logits_a, drafts_a); // freq_scale from the model: 1.0, rope_freqs 2.0
+        run(without,    0.5f, logits_b, drafts_b); // no rope_freqs, freq_scale 0.5
+        std::remove(with_freqs.c_str());
+        std::remove(without.c_str());
+
+        CHECK(logits_a.size() == logits_b.size());
+        CHECK(std::memcmp(logits_a.data(), logits_b.data(), logits_a.size() * sizeof(float)) == 0);
+        size_t n_diff = 0;
+        for (size_t i = 0; i < drafts_a.size(); ++i) {
+            n_diff += drafts_a[i] != drafts_b[i];
+        }
+        if (n_diff != 0) {
+            std::fprintf(stderr, "MTP drafts differ in %zu of %zu steps\n", n_diff, drafts_a.size());
+            return 1;
+        }
+
+        llama_backend_free();
+        std::printf("PASS: logits and %zu MTP drafts equal with rope_freqs 2.0 and with freq_scale 0.5\n", drafts_a.size());
+        return 0;
+    } catch (const std::exception & e) {
+        std::fprintf(stderr, "%s\n", e.what());
+        return 1;
+    }
+}
