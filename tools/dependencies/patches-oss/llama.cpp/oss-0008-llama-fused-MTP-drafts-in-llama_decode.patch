+// row j + d of the ubatch if its position is pos[j] + d; otherwise -1
+static int32_t llm_mtp_next_row(const llama_ubatch & ub, int32_t j, int32_t d) {
+    return j + d < (int32_t) ub.n_tokens && ub.pos[j + d] == ub.pos[j] + d ? j + d : -1;
+}
+
+static bool llm_mtp_is_out(const llama_ubatch & ub, int32_t n_outputs, int32_t j) {
+    return n_outputs == (int32_t) ub.n_tokens || (ub.output && ub.output[j]);
+}
+
+llm_mtp_layout llm_mtp_layout::make(const llama_ubatch & ub, int32_t n_outputs, int32_t n_mtp, int32_t r_max) {
+    llm_mtp_layout res;
+    res.n_out = n_outputs;
+
+    if (n_mtp <= 0 || n_outputs <= 0 || r_max <= 0 || !ub.token || ub.is_mixed()) {
+        return res;
+    }
+
+    const int32_t n  = ub.n_tokens;
+    res.R = std::min(n, r_max);
+
+    const int32_t j0 = n - res.R;
+
+    for (int32_t j = j0; j < n; ++j) {
+        if (llm_mtp_is_out(ub, n_outputs, j)) {
+            res.out_reg.push_back(j - j0);
+        }
+    }
+    res.n_out_reg = res.out_reg.size();
+    res.crop      = res.R < n && res.n_out_reg == n_outputs;
+    res.dyn       = res.R == n && res.n_out_reg == n && n > 1;
+
+    if (!res.dyn && res.n_out_reg > 0) {
+        res.h_row = res.out_reg.back();
+    }
+    if (!res.crop) {
+        res.out_reg.clear();
+    }
+
+    return res;
+}
