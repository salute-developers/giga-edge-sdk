+void llama_context::set_mtp_fused(int32_t n_drafts) {
+    const auto & hparams = model.hparams;
+
+    uint32_t n = 0;
+    if (n_drafts > 0) {
+        const bool loaded = model.arch == LLM_ARCH_QWEN3 && hparams.n_layer_nextn > 0 &&
+            model.layers[hparams.n_layer()].nextn.eh_proj != nullptr && cparams.ctx_type == LLAMA_CONTEXT_TYPE_DEFAULT;
+
+        if (!loaded) {
+            LLAMA_LOG_WARN("%s: no MTP layers loaded (needs a qwen3 model with MTP and load_mtp = true), fused MTP stays off\n", __func__);
+        } else if (!cparams.flash_attn) {
+            LLAMA_LOG_WARN("%s: fused MTP requires flash attention, stays off\n", __func__);
+        } else if (cparams.n_seq_max > 1) {
+            LLAMA_LOG_WARN("%s: fused MTP requires a single sequence (n_seq_max = 1), stays off\n", __func__);
+        } else if (!cparams.swa_full && hparams.is_swa_any()) {
+            // in a window ring buffer the cell layout after a draft rollback differs from step-by-step generation:
+            // the rows of a verification batch would not match decode bitwise
+            LLAMA_LOG_WARN("%s: fused MTP requires swa_full = true for a sliding window model, stays off\n", __func__);
+        } else {
+            n = std::min<uint32_t>(n_drafts, hparams.n_layer_nextn);
+        }
+    }
+
+    if (n == cparams.mtp_fused) {
+        return;
+    }
+
+    LLAMA_LOG_INFO("%s: fused MTP blocks = %u (rows per ubatch <= %u)\n", __func__, n, cparams.mtp_rows);
+
+    cparams.mtp_fused = n;
+
+    // the MTP layer KV and the drafts computed with a different number of blocks are not used
+    mtp_valid.clear();
+    mtp_drafts.clear();
+
+    sched_need_reserve = true;
+}
