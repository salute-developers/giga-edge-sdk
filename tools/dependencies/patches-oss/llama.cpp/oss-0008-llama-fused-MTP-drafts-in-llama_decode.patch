+int32_t llama_context::get_mtp_drafts_ith(int32_t i, llama_token * out, int32_t n_max) {
+    if (cparams.mtp_fused == 0 || mtp_drafts.empty() || n_max <= 0) {
+        return 0;
+    }
+
+    output_reorder();
+
+    int64_t j = -1;
+    try {
+        j = output_resolve_row(i);
+    } catch (const std::exception &) {
+        return 0;
+    }
+    if (j < 0 || j >= mtp_drafts_stride) {
+        return 0;
+    }
+
+    const int32_t n_blocks = (int32_t) (mtp_drafts.size() / mtp_drafts_stride);
+    int32_t n = 0;
+    for (; n < std::min<int32_t>(n_max, n_blocks); ++n) {
+        const llama_token t = mtp_drafts[n*mtp_drafts_stride + j];
+        if (t == LLAMA_TOKEN_NULL) {
+            break;
+        }
+        out[n] = t;
+    }
+
+    return n;
+}
