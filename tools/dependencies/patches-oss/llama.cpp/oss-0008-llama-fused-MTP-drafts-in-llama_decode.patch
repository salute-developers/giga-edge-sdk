+void llm_graph_input_mtp::set_input(const llama_ubatch * ubatch) {
+    const int32_t n  = ubatch->n_tokens;
+    const int32_t R  = layout.R;
+    const int32_t j0 = n - R;
+
+    // the MTP layer KV exists only in the cells of the region rows; the other cells of this ubatch have none
+    GGML_ASSERT(k_idxs_src && ggml_backend_buffer_is_host(k_idxs_src->buffer));
+    {
+        const int64_t * cells = (const int64_t *) k_idxs_src->data;
+        for (int32_t j = 0; j < n; ++j) {
+            const size_t c = cells[j];
+            if (c >= valid->size()) {
+                valid->resize(c + 1, 0);
+            }
+            (*valid)[c] = R > 0 && j >= j0;
+        }
+    }
+
+    if (R == 0) {
+        return;
+    }
+
+    const int32_t n_out = layout.n_out;
+    const int32_t h_row = layout.h_row;
+
+    // output index of each row of the ubatch
+    std::vector<int32_t> out_of(n, -1);
+    {
+        int32_t o = 0;
+        for (int32_t j = 0; j < n; ++j) {
+            if (llm_mtp_is_out(*ubatch, n_out, j)) {
+                out_of[j] = o++;
+            }
+        }
+    }
+
+    // embedding pool of block k: [batch (R) | argmax of the main model (n_out) | drafts of blocks 0..k-1 of row H]
+    // m-th token of the chain of row H: its argmax for m = 0, otherwise the draft of block m-1
+    auto chain_idx = [&](int32_t m) {
+        return m == 0 ? R + out_of[j0 + h_row] : R + n_out + m - 1;
+    };
+
+    // block k of row j takes the token of position q = pos_j+k+1:
+    //  - row H: from its own chain;
+    //  - if row q-1 is in the batch and is an output: its argmax (on the accepted path this is the right token);
+    //  - otherwise from the batch, and past the end of the batch from the chain of row H
+    for (int32_t k = 0; k < n_mtp; ++k) {
+        int32_t * t = (int32_t *) tok[k]->data;
+        int32_t * s = (int32_t *) sel[k]->data;
+
+        for (int32_t r = 0; r < R; ++r) {
+            const int32_t j = j0 + r;
+
+            t[r] = ubatch->token[j];
+            s[r] = r;
+
+            if (r == h_row) {
+                s[r] = chain_idx(k);
+                continue;
+            }
+
+            const int32_t jp = llm_mtp_next_row(*ubatch, j, k);
+            if (jp >= 0 && out_of[jp] >= 0) {
+                s[r] = R + out_of[jp];
+                continue;
+            }
+
+            const int32_t nx = llm_mtp_next_row(*ubatch, j, k + 1);
+            if (nx >= 0) {
+                t[r] = ubatch->token[nx];
+                continue;
+            }
+
+            if (h_row > r) {
+                const llama_pos m = ubatch->pos[j] + k - ubatch->pos[j0 + h_row];
+                if (m >= 0 && m <= k) {
+                    s[r] = chain_idx(m);
+                }
+            }
+        }
+    }
+
+    if (out_reg && out_reg->buffer) {
+        memcpy(out_reg->data, layout.out_reg.data(), layout.out_reg.size()*sizeof(int32_t));
+    }
+
+    if (iota && iota->buffer) {
+        for (int32_t r = 0; r < R; ++r) {
+            ((float *) iota->data)[r] = r;
+        }
+    }
+    if (nxt && nxt->buffer) {
+        for (int32_t r = 1; r < R; ++r) {
+            ((float *) nxt->data)[r - 1] = ubatch->token[j0 + r];
+        }
+    }
+
+    // mask: the region rows of the main model mask, minus the cells without MTP layer KV
+    GGML_ASSERT(mask_src && ggml_backend_buffer_is_host(mask_src->buffer));
+    GGML_ASSERT(mask->type == mask_src->type && mask->ne[0] == mask_src->ne[0]);
+
+    const int64_t n_kv  = mask->ne[0];
+    const size_t  row_b = n_kv*ggml_element_size(mask);
+
+    std::vector<uint8_t> rows(R*row_b);
+    for (int32_t r = 0; r < R; ++r) {
+        memcpy(rows.data() + r*row_b, (const char *) mask_src->data + (j0 + r)*mask_src->nb[1], row_b);
+    }
+    for (int64_t c = 0; c < n_kv; ++c) {
+        if ((size_t) c < valid->size() && (*valid)[c]) {
+            continue;
+        }
+        for (int32_t r = 0; r < R; ++r) {
+            if (mask->type == GGML_TYPE_F16) {
+                ((ggml_fp16_t *) (rows.data() + r*row_b))[c] = ggml_fp32_to_fp16(-INFINITY);
+            } else {
+                ((float *) (rows.data() + r*row_b))[c] = -INFINITY;
+            }
+        }
+    }
+
+    // the inputs the graph does not use are not allocated
+    if (mask->buffer) {
+        for (int32_t r = 0; r < R; ++r) {
+            memcpy((char *) mask->data + r*mask->nb[1], rows.data() + r*row_b, row_b);
+        }
+    }
+    if (h_idx && h_idx->buffer) {
+        ((int32_t *) h_idx->data)[0] = h_row;
+    }
+    if (mask_h && mask_h->buffer) {
+        memcpy(mask_h->data, rows.data() + h_row*row_b, row_b);
+        ((int32_t *) pos_h->data)[0] = ubatch->pos[j0 + h_row];
+    }
+}
+
+bool llm_graph_input_mtp::can_reuse(const llm_graph_params & params) {
+    auto other = llm_mtp_layout::make(params.ubatch, params.n_outputs, n_mtp, r_max);
+
+    if (other.R != layout.R || other.n_out != layout.n_out || other.crop != layout.crop || other.dyn != layout.dyn ||
+        other.n_out_reg != layout.n_out_reg || (other.h_row >= 0) != (layout.h_row >= 0)) {
+        return false;
+    }
+
+    layout = std::move(other);
+
+    return true;
+}
