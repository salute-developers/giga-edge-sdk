+// Fused MTP: layout of the ubatch rows for the chain of MTP blocks (a single sequence).
+// MTP is computed for the last R rows of the ubatch (only if the ubatch has outputs). The full output of the last block and
+// the drafts are needed only on row H: the last output of the ubatch or, in a verification batch (all rows are outputs),
+// the row of the first rejection, which the graph finds (dyn). The other rows need only the MTP layer KV.
+struct llm_mtp_layout {
+    int32_t R         = 0;
+    int32_t n_out     = 0;     // outputs in the ubatch
+    int32_t n_out_reg = 0;     // of them inside the region (always the last outputs)
+    bool    crop      = false; // the region is shorter than the ubatch and holds all outputs: the last main model layer runs only on the region
+    bool    dyn       = false; // verification batch: the graph picks row H
+    int32_t h_row     = -1;    // row H inside the region if not dyn; -1 if none
+    std::vector<int32_t> out_reg; // with crop: the outputs inside the region
+
+    static llm_mtp_layout make(const llama_ubatch & ubatch, int32_t n_outputs, int32_t n_mtp, int32_t r_max);
+};
