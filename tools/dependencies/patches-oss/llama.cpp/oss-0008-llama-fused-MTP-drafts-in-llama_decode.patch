+    ggml_tensor * pool_chain = ggml_get_rows(ctx0, model.tok_embd, am);
+
+    // the MTP layers apply rope like the main ones: the model has one rope_freqs for all layers (nullptr if absent)
+    ggml_tensor * rope_factors = model.get_rope_factors(cparams, 0);
+
+    // with dyn the drafts are written out for all rows of the batch: row H gets its own, the others LLAMA_TOKEN_NULL
+    res->mtp_n_out_reg = L.dyn ? R : nH;
+
+    for (int k = 0; k < inp->n_mtp; ++k) {
+        const int il = n_layer + k;
+        const auto & layer = model.layers[il];
+
+        ggml_tensor * tok = ggml_new_tensor_1d(ctx0, GGML_TYPE_I32, R);
+        ggml_tensor * sel = ggml_new_tensor_1d(ctx0, GGML_TYPE_I32, R);
+        ggml_set_input(tok);
+        ggml_set_input(sel);
+        inp->tok.push_back(tok);
+        inp->sel.push_back(sel);
+
+        if (L.dyn && k > 0) {
+            // rows a-k+1..a precede row H: their token past the accepted edge comes from its chain,
+            // row a-c needs the draft of block k-1-c (in the pool after the batch and the argmax)
+            ggml_tensor * s = ggml_cast(ctx0, sel, GGML_TYPE_F32);
+            for (int c = 0; c < k; ++c) {
+                ggml_tensor * m = row_is(c);
+                s = ggml_add(ctx0, ggml_mul(ctx0, s, ggml_scale_bias(ctx0, m, -1.0f, 1.0f)), ggml_scale(ctx0, m, (float) (2*R + k - 1 - c)));
+            }
+            sel = ggml_cast(ctx0, s, GGML_TYPE_I32);
+        }
+
+        ggml_tensor * emb = ggml_get_rows(ctx0, model.tok_embd, tok);
+        emb = ggml_get_rows(ctx0, ggml_concat(ctx0, emb, pool_chain, 1), sel);
+
+        ggml_tensor * e_norm = build_norm(emb, layer.nextn.enorm, NULL, LLM_NORM_RMS, il);
+        ggml_tensor * h_norm = build_norm(h,   layer.nextn.hnorm, NULL, LLM_NORM_RMS, il);
+
+        ggml_tensor * x = build_lora_mm(layer.nextn.eh_proj, ggml_concat(ctx0, e_norm, h_norm, 0), nullptr);
+        cb(x, "mtp_eh_proj", il);
+
+        // the last block needs its output only on the H rows, on the others only its K/V
+        const bool part = k == inp->n_mtp - 1 && nH < R;
+
+        ggml_tensor * cur = build_norm(x, layer.attn_norm, NULL, LLM_NORM_RMS, il);
+        {
+            GGML_ASSERT(layer.wqkv == nullptr && layer.wq_b == nullptr && layer.wk_b == nullptr && layer.wv_b == nullptr);
+
+            ggml_tensor * Kcur = ggml_reshape_3d(ctx0, build_lora_mm(layer.wk, cur, layer.wk_s), n_embd_head, n_head_kv, R);
+            ggml_tensor * Vcur = ggml_reshape_3d(ctx0, build_lora_mm(layer.wv, cur, layer.wv_s), n_embd_head, n_head_kv, R);
+
+            Kcur = build_norm(Kcur, layer.attn_k_norm, NULL, LLM_NORM_RMS, il);
+            Kcur = ggml_rope_ext(ctx0, Kcur, pos, rope_factors,
+                    n_rot, rope_type, n_ctx_orig, freq_base, freq_scale,
+                    ext_factor, attn_factor, beta_fast, beta_slow);
+
+            ggml_build_forward_expand(gf, mctx_mtp->cpy_k(ctx0, Kcur, k_idx, il));
+            ggml_build_forward_expand(gf, mctx_mtp->cpy_v(ctx0, Vcur, v_idx, il));
+
+            if (part && nH == 0) {
+                break;
+            }
+
+            ggml_tensor * q_in = part ? ggml_get_rows(ctx0, cur, h_idx) : cur;
+            const int64_t n_q  = part ? nH : R;
+
+            ggml_tensor * Qcur = ggml_reshape_3d(ctx0, build_lora_mm(layer.wq, q_in, layer.wq_s), n_embd_head, n_head, n_q);
+            Qcur = build_norm(Qcur, layer.attn_q_norm, NULL, LLM_NORM_RMS, il);
+            Qcur = ggml_rope_ext(ctx0, Qcur, part ? pos_h : pos, rope_factors,
+                    n_rot, rope_type, n_ctx_orig, freq_base, freq_scale,
+                    ext_factor, attn_factor, beta_fast, beta_slow);
+
+            cur = build_attn_mha(Qcur, mctx_mtp->get_k(ctx0, il), mctx_mtp->get_v(ctx0, il),
+                    nullptr, part ? mask_h : inp->mask, nullptr, nullptr, 0, 1.0f/sqrtf(float(n_embd_head)), il);
+            cur = build_lora_mm(layer.wo, cur, layer.wo_s);
+
+            if (part) {
+                x = ggml_get_rows(ctx0, x, h_idx);
+            }
+        }
+
+        ggml_tensor * ffn_inp = ggml_add(ctx0, cur, x);
+
+        cur = build_norm(ffn_inp, layer.ffn_norm, NULL, LLM_NORM_RMS, il);
+        cur = build_ffn(cur,
+                layer.ffn_up,   NULL, layer.ffn_up_s,
+                layer.ffn_gate, NULL, layer.ffn_gate_s,
+                layer.ffn_down, NULL, layer.ffn_down_s,
+                NULL,
+                LLM_FFN_SILU, LLM_FFN_PAR, il);
+        cur = ggml_add(ctx0, cur, ffn_inp);
+
+        h = build_norm(cur, layer.nextn.shared_head_norm, NULL, LLM_NORM_RMS, il);
+        cb(h, "mtp_out", il);
+
+        if (nH > 0) {
+            ggml_tensor * logits = build_lora_mm(model.output, part ? h : ggml_get_rows(ctx0, h, h_idx), model.output_s);
+            ggml_tensor * draft  = ggml_argmax(ctx0, logits);
+            cb(draft, "mtp_draft", il);
+
+            ggml_tensor * out = draft;
+            if (L.dyn) {
+                out = ggml_scale_bias(ctx0, ggml_cast(ctx0, draft, GGML_TYPE_F32), 1.0f, 1.0f);
+                out = ggml_cast(ctx0, ggml_scale_bias(ctx0, ggml_mul(ctx0, row_is(0), out), 1.0f, (float) LLAMA_TOKEN_NULL), GGML_TYPE_I32);
+            }
+            res->t_mtp_drafts.push_back(out);
+            ggml_build_forward_expand(gf, out);
+
+            if (k + 1 < inp->n_mtp) {
+                pool_chain = ggml_concat(ctx0, pool_chain, ggml_get_rows(ctx0, model.tok_embd, draft), 1);
+            }
+        } else {
+            ggml_build_forward_expand(gf, h);
+        }
+    }
 }
