+++ b/src/unicode.cpp
@@ -1018,6 +1018,181 @@ static std::vector<size_t> unicode_regex_split_custom_afmoe(const std::string &
     return bpe_offsets;
 }
 
+// GPT-4o regex, as converted in llama-vocab.cpp:
+// "[^\r\n\p{L}\p{N}]?((?=[\p{L}])([^a-z]))*((?=[\p{L}])([^A-Z]))+(?:'[sS]|'[tT]|'[rR][eE]|'[vV][eE]|'[mM]|'[lL][lL]|'[dD])?|[^\r\n\p{L}\p{N}]?((?=[\p{L}])([^a-z]))+((?=[\p{L}])([^A-Z]))*(?:'[sS]|'[tT]|'[rR][eE]|'[vV][eE]|'[mM]|'[lL][lL]|'[dD])?|\p{N}{1,3}| ?[^\s\p{L}\p{N}]+[\r\n/]*|\s*[\r\n]+|\s+(?!\S)|\s+"
+// Character classes follow the std::regex fallback over the collapsed text: ASCII as is, other codepoints by
+// category, so a non-ASCII letter is both [^a-z] and [^A-Z].
+static std::vector<size_t> unicode_regex_split_custom_gpt4o(const std::string & text, const std::vector<size_t> & offsets) {
+    std::vector<size_t> bpe_offsets;
+    bpe_offsets.reserve(offsets.size());
+
+    const auto cpts = unicode_cpts_from_utf8(text);
+
+    size_t start = 0;
+    for (auto offset : offsets) {
+        const size_t offset_ini = start;
+        const size_t offset_end = start + offset;
+        assert(offset_end <= cpts.size());
+        start = offset_end;
+
+        static const uint32_t OUT_OF_RANGE = 0xFFFFFFFF;
+        auto _get_cpt = [&] (const size_t pos) -> uint32_t {
+            return (offset_ini <= pos && pos < offset_end) ? cpts[pos] : OUT_OF_RANGE;
+        };
+
+        // \s, \p{L} and \p{N}
+        auto _is_space = [&] (const size_t pos) -> bool {
+            const uint32_t cpt = _get_cpt(pos);
+            if (cpt < 128) {
+                return cpt == ' ' || (cpt >= '\t' && cpt <= '\r');
+            }
+            return cpt != OUT_OF_RANGE && unicode_cpt_flags_from_cpt(cpt).is_whitespace;
+        };
+        auto _is_category = [&] (const size_t pos, const uint16_t category) -> bool {
+            const uint32_t cpt = _get_cpt(pos);
+            if (cpt < 128) {
+                return category == unicode_cpt_flags::NUMBER
+                    ? (cpt >= '0' && cpt <= '9')
+                    : ((cpt >= 'a' && cpt <= 'z') || (cpt >= 'A' && cpt <= 'Z'));
+            }
+            if (cpt == OUT_OF_RANGE) {
+                return false;
+            }
+            const auto flags = unicode_cpt_flags_from_cpt(cpt);
+            return !flags.is_whitespace && flags.category_flag() == category;
+        };
+        auto _is_letter = [&] (const size_t pos) { return _is_category(pos, unicode_cpt_flags::LETTER); };
+        auto _is_number = [&] (const size_t pos) { return _is_category(pos, unicode_cpt_flags::NUMBER); };
+        // (?=[\p{L}])([^a-z]) and (?=[\p{L}])([^A-Z])
+        auto _is_upper = [&] (const size_t pos) {
+            const uint32_t cpt = _get_cpt(pos);
+            return _is_letter(pos) && !(cpt >= 'a' && cpt <= 'z');
+        };
+        auto _is_lower = [&] (const size_t pos) {
+            const uint32_t cpt = _get_cpt(pos);
+            return _is_letter(pos) && !(cpt >= 'A' && cpt <= 'Z');
+        };
+        auto _is_other = [&] (const size_t pos) {
+            return _get_cpt(pos) != OUT_OF_RANGE && !_is_space(pos) && !_is_letter(pos) && !_is_number(pos);
+        };
+        // (?:'[sS]|'[tT]|'[rR][eE]|'[vV][eE]|'[mM]|'[lL][lL]|'[dD])
+        auto _contraction = [&] (const size_t pos) -> size_t {
+            if (_get_cpt(pos) != '\'') {
+                return 0;
+            }
+            auto _is = [] (const uint32_t cpt, const char lower) {
+                return cpt == (uint32_t) lower || cpt == (uint32_t) (lower - 'a' + 'A');
+            };
+            const uint32_t c1 = _get_cpt(pos + 1);
+            const uint32_t c2 = _get_cpt(pos + 2);
+            if (_is(c1, 's') || _is(c1, 't') || _is(c1, 'm') || _is(c1, 'd')) {
+                return 2;
+            }
+            if ((_is(c1, 'r') && _is(c2, 'e')) || (_is(c1, 'v') && _is(c2, 'e')) || (_is(c1, 'l') && _is(c2, 'l'))) {
+                return 3;
+            }
+            return 0;
+        };
+
+        size_t _prev_end = offset_ini;
+        auto _add_token = [&] (const size_t end) -> size_t {
+            assert(_prev_end <= end && end <= offset_end);
+            size_t len = end - _prev_end;
+            if (len > 0) {
+                bpe_offsets.push_back(len);
+            }
+            _prev_end = end;
+            return len;
+        };
+
+        for (size_t pos = offset_ini; pos < offset_end; /*pos++*/ ) {
+            const uint32_t cpt = _get_cpt(pos);
+
+            // regex: [^\r\n\p{L}\p{N}]?<upper>*<lower>+(?:'s|...)? | [^\r\n\p{L}\p{N}]?<upper>+<lower>*(?:'s|...)?
+            const size_t word = (cpt != '\r' && cpt != '\n' && !_is_letter(pos) && !_is_number(pos)) ? pos + 1 : pos;
+            if (_is_letter(word)) {
+                size_t end = word;
+                while (_is_upper(end)) {
+                    end++;
+                }
+                if (_is_lower(end)) {
+                    while (_is_lower(end)) {
+                        end++;
+                    }
+                } else {
+                    // backtrack <upper>* to its last letter that is <lower> too, otherwise the second branch takes it all
+                    size_t last = end;
+                    while (last > word && !_is_lower(last - 1)) {
+                        last--;
+                    }
+                    if (last > word) {
+                        end = last;
+                    }
+                }
+                pos += _add_token(end + _contraction(end));
+                continue;
+            }
+
+            // regex: \p{N}{1,3}
+            if (_is_number(pos)) {
+                size_t end = pos + 1;
+                while (end < pos + 3 && _is_number(end)) {
+                    end++;
+                }
+                pos += _add_token(end);
+                continue;
+            }
+
+            // regex: <space>?[^\s\p{L}\p{N}]+[\r\n/]*
+            const size_t punct = (cpt == ' ' && _is_other(pos + 1)) ? pos + 1 : pos;
+            if (_is_other(punct)) {
+                size_t end = punct;
+                while (_is_other(end)) {
+                    end++;
+                }
+                while (_get_cpt(end) == '\r' || _get_cpt(end) == '\n' || _get_cpt(end) == '/') {
+                    end++;
+                }
+                pos += _add_token(end);
+                continue;
+            }
+
+            size_t num_whitespaces = 0;
+            size_t last_end_r_or_n = 0;
+            while (_is_space(pos + num_whitespaces)) {
+                const uint32_t cpt2 = _get_cpt(pos + num_whitespaces);
+                if (cpt2 == '\r' || cpt2 == '\n') {
+                    last_end_r_or_n = pos + num_whitespaces + 1;
+                }
+                num_whitespaces++;
+            }
+
+            // regex: \s*[\r\n]+
+            if (last_end_r_or_n > 0) {
+                pos += _add_token(last_end_r_or_n);
+                continue;
+            }
+
+            // regex: \s+(?!\S)
+            if (num_whitespaces > 1 && _get_cpt(pos + num_whitespaces) != OUT_OF_RANGE) {
+                pos += _add_token(pos + num_whitespaces - 1);
+                continue;
+            }
+
+            // regex: \s+
+            if (num_whitespaces > 0) {
+                pos += _add_token(pos + num_whitespaces);
+                continue;
+            }
+
+            // no matches
+            pos += _add_token(pos + 1);
+        }
+    }
+
+    return bpe_offsets;
+}
+
 // regex: [^\n]+|[\n]+
 // splits text into runs of non-newline characters and runs of newline characters
 static std::vector<size_t> unicode_regex_split_custom_newlines(const std::string & text, const std::vector<size_t> & offsets) {
@@ -1068,6 +1243,8 @@ static std::vector<size_t> unicode_regex_split_custom(const std::string & text,
     } else if (regex_expr == "\\p{AFMoE_digits}") {
         // AFMOE digit pattern - use custom implementation for proper splitting
         bpe_offsets = unicode_regex_split_custom_afmoe(text, offsets);
+    } else if (regex_expr == "[^\\r\\n\\p{L}\\p{N}]?((?=[\\p{L}])([^a-z]))*((?=[\\p{L}])([^A-Z]))+(?:'[sS]|'[tT]|'[rR][eE]|'[vV][eE]|'[mM]|'[lL][lL]|'[dD])?|[^\\r\\n\\p{L}\\p{N}]?((?=[\\p{L}])([^a-z]))+((?=[\\p{L}])([^A-Z]))*(?:'[sS]|'[tT]|'[rR][eE]|'[vV][eE]|'[mM]|'[lL][lL]|'[dD])?|\\p{N}{1,3}| ?[^\\s\\p{L}\\p{N}]+[\\r\\n/]*|\\s*[\\r\\n]+|\\s+(?!\\S)|\\s+") {
+        bpe_offsets = unicode_regex_split_custom_gpt4o(text, offsets);
     } else if (regex_expr == "[^\\n]+|[\\n]+") {
         bpe_offsets = unicode_regex_split_custom_newlines(text, offsets);
     } else if (regex_expr == "\\d{1,3}(?=(?:\\d{3})*\\b)") {
