diff --git a/tests/test-unicode-gpt4o.cpp b/tests/test-unicode-gpt4o.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..c02a3eb82375e11f2c2321071c3156b7f210fd46
--- /dev/null
+++ b/tests/test-unicode-gpt4o.cpp
@@ -0,0 +1,86 @@
+// The custom GPT-4o split must give exactly what the std::regex fallback gives for the same regex.
+#include "../src/unicode.h"
+
+#include <chrono>
+#include <cstdio>
+#include <fstream>
+#include <random>
+#include <sstream>
+#include <string>
+#include <vector>
+
+static const std::string k_gpt4o =
+    "[^\\r\\n\\p{L}\\p{N}]?((?=[\\p{L}])([^a-z]))*((?=[\\p{L}])([^A-Z]))+(?:'[sS]|'[tT]|'[rR][eE]|'[vV][eE]|'[mM]|'[lL][lL]|'[dD])?|[^\\r\\n\\p{L}\\p{N}]?((?=[\\p{L}])([^a-z]))+((?=[\\p{L}])([^A-Z]))*(?:'[sS]|'[tT]|'[rR][eE]|'[vV][eE]|'[mM]|'[lL][lL]|'[dD])?|\\p{N}{1,3}| ?[^\\s\\p{L}\\p{N}]+[\\r\\n/]*|\\s*[\\r\\n]+|\\s+(?!\\S)|\\s+";
+
+static double g_custom_ms = 0;
+static double g_stl_ms = 0;
+
+static bool same_split(const std::string & text) {
+    using clock = std::chrono::steady_clock;
+    const auto t0 = clock::now();
+    const auto custom = unicode_regex_split(text, { k_gpt4o }, false);
+    const auto t1 = clock::now();
+    // a group around the whole regex keeps its meaning but skips the custom implementation
+    const auto stl = unicode_regex_split(text, { "(?:" + k_gpt4o + ")" }, false);
+    const auto t2 = clock::now();
+    g_custom_ms += std::chrono::duration<double, std::milli>(t1 - t0).count();
+    g_stl_ms += std::chrono::duration<double, std::milli>(t2 - t1).count();
+    if (custom == stl) {
+        return true;
+    }
+    fprintf(stderr, "mismatch for \"%s\"\n custom:", text.c_str());
+    for (const auto & piece : custom) {
+        fprintf(stderr, " [%s]", piece.c_str());
+    }
+    fprintf(stderr, "\n stl:   ");
+    for (const auto & piece : stl) {
+        fprintf(stderr, " [%s]", piece.c_str());
+    }
+    fprintf(stderr, "\n");
+    return false;
+}
+
+int main(int argc, char ** argv) {
+    const std::vector<std::string> fixed = {
+        "Hello world", " Лампа 1", "HELLOworld", "ЛампаHELLO", "ЛампаHE", "don't DON'T we're I'LL", "  \n\n  x",
+        "1234567", " 12", "x  y", "a\r\n\r\n b", "<d_light>0 Лампа 1<sep>включи лампу", "{\"status\": \"success\", \"value\": 37.5}",
+        "end.\n/next", "Ǆemo ʰx Ⅻ ²", "\xC2\xA0word", "tab\tword", "", " ", "\n", "'s", "e\xCC\x81t\xC3\xA9", "😀😀 ok",
+    };
+    bool ok = true;
+    for (const auto & text : fixed) {
+        ok = same_split(text) && ok;
+    }
+
+    // all classes the regex distinguishes, plus their unicode corners
+    const std::vector<std::string> alphabet = {
+        "a", "z", "q", "A", "Z", "Q", "s", "t", "m", "d", "l", "r", "v", "e", "S", "T", "L", "E",
+        "0", "5", "9", " ", " ", " ", "\t", "\n", "\r", "\v", "\f", "'", "/", ".", ",", "!", "-", "\"", "<", ">", "{", "}",
+        "_", "\x01", "\x1f", "ж", "Ж", "я", "Я", "ё", "Ё", "ß", "ǅ", "ʰ", "λ", "Λ", "中", "あ", "\xCC\x81", "\xC2\xA0",
+        "\xE2\x80\x83", "\xC2\x85", "\xE2\x80\xA8", "٣", "²", "Ⅻ", "😀", "€", "§", "\xEF\xBF\xBD",
+    };
+    std::mt19937 rng(42);
+    for (int i = 0; i < 20000; ++i) {
+        std::string text;
+        const int len = 1 + (int) (rng() % 40);
+        for (int j = 0; j < len; ++j) {
+            text += alphabet[rng() % alphabet.size()];
+        }
+        ok = same_split(text) && ok;
+    }
+
+    // real texts: each file is checked whole and line by line
+    for (int i = 1; i < argc; ++i) {
+        std::ifstream file(argv[i]);
+        std::stringstream buffer;
+        buffer << file.rdbuf();
+        const std::string text = buffer.str();
+        ok = same_split(text) && ok;
+        std::istringstream lines(text);
+        for (std::string line; std::getline(lines, line);) {
+            ok = same_split(line) && ok;
+        }
+    }
+
+    fprintf(stderr, "custom %.1f ms, std::regex %.1f ms\n", g_custom_ms, g_stl_ms);
+    return ok ? 0 : 1;
+}
