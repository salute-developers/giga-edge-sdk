@@ -599,6 +599,29 @@ struct llama_model_qwen3 : public llama_model_base {
 };
 
 
+// Qwen3 as a bidirectional encoder with a token tagging head: layer norm without parameters of the outputs of
+// some layers, side by side, Linear -> GELU -> Linear. One logit per tag for every token (n_embd_out).
+// The weights of the backbone are loaded as for qwen3, the graph is its own: no KV cache, every token is output.
+struct llama_model_span_tagger : public llama_model_qwen3 {
+    llama_model_span_tagger(const struct llama_model_params & params) : llama_model_qwen3(params) {}
+    void load_arch_hparams(llama_model_loader & ml) override;
+    void load_arch_tensors(llama_model_loader & ml) override;
+
+    std::vector<uint32_t> tap_layers; // 1-based, n_layer is the output after the final norm
+
+    ggml_tensor * fc1   = nullptr;
+    ggml_tensor * fc1_b = nullptr;
+    ggml_tensor * fc2   = nullptr;
+    ggml_tensor * fc2_b = nullptr;
+
+    struct graph : public llm_graph_context {
+        graph(const llama_model & model, const llm_graph_params & params);
+    };
+
+    std::unique_ptr<llm_graph_context> build_arch_graph(const llm_graph_params & params) const override;
+};
+
