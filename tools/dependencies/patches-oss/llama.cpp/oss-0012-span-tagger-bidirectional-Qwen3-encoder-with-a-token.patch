diff --git a/src/models/span-tagger.cpp b/src/models/span-tagger.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..df0d9bb862231922c55ea8dbe2b1cf4022ed9bd9
--- /dev/null
+++ b/src/models/span-tagger.cpp
@@ -0,0 +1,174 @@
+#include "models.h"
+
+#include <algorithm>
+#include <stdexcept>
+
+void llama_model_span_tagger::load_arch_hparams(llama_model_loader & ml) {
+    llama_model_qwen3::load_arch_hparams(ml);
+
+    // a bidirectional encoder over the whole text: a sliding window key from the backbone config does not apply
+    hparams.swa_type = LLAMA_SWA_TYPE_NONE;
+    hparams.n_swa    = 0;
+    std::fill(hparams.is_swa_impl.begin(), hparams.is_swa_impl.end(), false);
+
+    // the normalisation of the taps has no weights, torch.nn.functional.layer_norm
+    ml.get_key(LLM_KV_ATTENTION_LAYERNORM_EPS, hparams.f_norm_eps);
+
+    // 1-based: N is the output of layer N, n_layer is the output after the final norm
+    ml.get_arr(LLM_KV_TAGGER_TAP_LAYERS, tap_layers);
+    if (tap_layers.empty()) {
+        throw std::runtime_error("the tagger needs at least one tapped layer");
+    }
+    for (const uint32_t il : tap_layers) {
+        if (il < 1 || il > hparams.n_layer()) {
+            throw std::runtime_error("tapped layer out of range");
+        }
+    }
+}
+
+void llama_model_span_tagger::load_arch_tensors(llama_model_loader & ml) {
+    llama_model_qwen3::load_arch_tensors(ml);
+
+    LLAMA_LOAD_LOCALS;
+
+    const auto * w_fc1 = ml.get_weight(tn(LLM_TENSOR_TAGGER_FC1, "weight").str().c_str());
+    if (w_fc1 == nullptr) {
+        throw std::runtime_error("the tagger head is missing");
+    }
+    const int64_t n_in     = n_embd * (int64_t) tap_layers.size();
+    const int64_t n_hidden = w_fc1->tensor->ne[1];
+    const int64_t n_tags   = hparams.n_embd_out();
+
+    fc1   = create_tensor(tn(LLM_TENSOR_TAGGER_FC1, "weight"), {n_in, n_hidden}, 0);
+    fc1_b = create_tensor(tn(LLM_TENSOR_TAGGER_FC1, "bias"),   {n_hidden}, 0);
+    fc2   = create_tensor(tn(LLM_TENSOR_TAGGER_FC2, "weight"), {n_hidden, n_tags}, 0);
+    fc2_b = create_tensor(tn(LLM_TENSOR_TAGGER_FC2, "bias"),   {n_tags}, 0);
+}
+
+std::unique_ptr<llm_graph_context> llama_model_span_tagger::build_arch_graph(const llm_graph_params & params) const {
+    return std::make_unique<graph>(*this, params);
+}
+
+// The layers are those of qwen3.cpp with three differences: attention without a KV cache (bidirectional,
+// as for BERT), no selection of the output rows (the taps of the earlier layers have a row per token)
+// and the tagging head instead of the LM head.
+llama_model_span_tagger::graph::graph(const llama_model & model_base, const llm_graph_params & params) :
+    llm_graph_context(params) {
+    const auto & model = static_cast<const llama_model_span_tagger &>(model_base);
+
+    const int64_t n_embd_head = hparams.n_embd_head_v();
+
+    GGML_ASSERT(n_embd_head == hparams.n_embd_head_k());
+    GGML_ASSERT(n_embd_head == n_rot);
+    GGML_ASSERT(n_outputs == n_tokens && "the span tagger needs the output of every token");
+
+    ggml_tensor * cur;
+    ggml_tensor * inpL;
+
+    inpL = build_inp_embd(model.tok_embd);
+
+    // inp_pos - contains the positions
+    ggml_tensor * inp_pos = build_inp_pos();
+
+    auto * inp_attn = build_attn_inp_no_cache();
+
+    // the output of every layer before the final norm
+    std::vector<ggml_tensor *> l_out;
+    l_out.reserve(n_layer);
+
+    for (int il = 0; il < n_layer; ++il) {
+        ggml_tensor * inpSA = inpL;
+
+        // norm
+        cur = build_norm(inpL,
+                model.layers[il].attn_norm, NULL,
+                LLM_NORM_RMS, il);
+        cb(cur, "attn_norm", il);
+
+        // self-attention
+        {
+            // compute Q and K and RoPE them
+            auto [Qcur, Kcur, Vcur] = build_qkv(model.layers[il], cur,
+                    n_embd_head, n_head, n_head_kv, il);
+
+            Qcur = build_norm(Qcur, model.layers[il].attn_q_norm, NULL, LLM_NORM_RMS, il);
+            cb(Qcur, "Qcur_normed", il);
+
+            // per-dim frequency factors (llama3 rope scaling); nullptr when the file has none
+            ggml_tensor * rope_factors = model.get_rope_factors(cparams, il);
+
+            Qcur = ggml_rope_ext(
+                    ctx0, Qcur, inp_pos, rope_factors,
+                    n_rot, rope_type, n_ctx_orig, freq_base, freq_scale,
+                    ext_factor, attn_factor, beta_fast, beta_slow
+                    );
+
+            Kcur = build_norm(Kcur, model.layers[il].attn_k_norm, NULL, LLM_NORM_RMS, il);
+            cb(Kcur, "Kcur_normed", il);
+
+            Kcur = ggml_rope_ext(
+                    ctx0, Kcur, inp_pos, rope_factors,
+                    n_rot, rope_type, n_ctx_orig, freq_base, freq_scale,
+                    ext_factor, attn_factor, beta_fast, beta_slow
+                    );
+
+            cb(Qcur, "Qcur", il);
+            cb(Kcur, "Kcur", il);
+            cb(Vcur, "Vcur", il);
+
+            cur = build_attn(inp_attn,
+                    model.layers[il].wo, model.layers[il].wo_b, model.layers[il].wo_s,
+                    Qcur, Kcur, Vcur, nullptr, nullptr, nullptr, 1.0f/sqrtf(float(n_embd_head)), il);
+        }
+        ggml_tensor * ffn_inp = ggml_add(ctx0, cur, inpSA);
+        cb(ffn_inp, "ffn_inp", il);
+
+        // feed-forward network
+        cur = build_norm(ffn_inp,
+                model.layers[il].ffn_norm, NULL,
+                LLM_NORM_RMS, il);
+        cb(cur, "ffn_norm", il);
+
+        cur = build_ffn(cur,
+                model.layers[il].ffn_up,   NULL, model.layers[il].ffn_up_s,
+                model.layers[il].ffn_gate, NULL, model.layers[il].ffn_gate_s,
+                model.layers[il].ffn_down, NULL, model.layers[il].ffn_down_s,
+                NULL,
+                LLM_FFN_SILU, LLM_FFN_PAR, il);
+        cb(cur, "ffn_out", il);
+
+        cur = ggml_add(ctx0, cur, ffn_inp);
+
+        cur = build_cvec(cur, il);
+        cb(cur, "l_out", il);
+        l_out.push_back(cur);
+
+        // input for next layer
+        inpL = cur;
+    }
+
+    // after the final norm: [n_embd, n_tokens]
+    ggml_tensor * last = build_norm(inpL,
+            model.output_norm, NULL,
+            LLM_NORM_RMS, -1);
+    cb(last, "result_norm", -1);
+
+    // layer norm without parameters of each tapped layer, then the taps side by side
+    cur = nullptr;
+    for (const uint32_t il : model.tap_layers) {
+        ggml_tensor * tap = il == (uint32_t) n_layer ? last : l_out[il - 1];
+        tap = build_norm(tap, nullptr, nullptr, LLM_NORM, -1);
+        cur = cur == nullptr ? tap : ggml_concat(ctx0, cur, tap, 0);
+    }
+    cb(cur, "tagger_taps", -1);
+
+    // head: Linear -> GELU -> Linear, one logit per tag
+    cur = ggml_add(ctx0, ggml_mul_mat(ctx0, model.fc1, cur), model.fc1_b);
+    cur = ggml_gelu_erf(ctx0, cur);
+    cur = ggml_add(ctx0, ggml_mul_mat(ctx0, model.fc2, cur), model.fc2_b);
+
+    cb(cur, "result_tagger", -1);
+    res->t_embd = cur;
+
+    ggml_build_forward_expand(gf, cur);
+}
