diff --git a/tests/test-span-tagger.cpp b/tests/test-span-tagger.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..b0221122d08877b78972ccd59ce8c854ab8cc5a9
--- /dev/null
+++ b/tests/test-span-tagger.cpp
@@ -0,0 +1,154 @@
+// span-tagger is a bidirectional encoder: a sliding window key inherited from the Qwen3 backbone config must not
+// turn it into an iSWA model. Two tiny random models that differ only in that key must give the same tags.
+
+#include "llama.h"
+#include "ggml.h"
+#include "gguf.h"
+
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <random>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+#define CHECK(condition) do { if (!(condition)) throw std::runtime_error("check failed: " #condition); } while (false)
+
+static const int64_t n_vocab = 32, n_embd = 32, n_head = 2, n_head_kv = 1, n_ff = 64, n_layer = 2;
+static const int64_t n_hidden = 16, n_tags = 5, n_head_dim = n_embd / n_head;
+
+static void write_model(const std::string & path, bool sliding_window) {
+    const char * arch = "span-tagger";
+    gguf_context * gguf = gguf_init_empty();
+    auto key = [&](const char * name) { return std::string(arch) + "." + name; };
+
+    gguf_set_val_str(gguf, "general.architecture", arch);
+    gguf_set_val_str(gguf, "tokenizer.ggml.model", "no_vocab");
+    gguf_set_val_u32(gguf, key("vocab_size").c_str(),                     n_vocab);
+    gguf_set_val_u32(gguf, key("context_length").c_str(),                 64);
+    gguf_set_val_u32(gguf, key("embedding_length").c_str(),               n_embd);
+    gguf_set_val_u32(gguf, key("embedding_length_out").c_str(),           n_tags);
+    gguf_set_val_u32(gguf, key("feed_forward_length").c_str(),            n_ff);
+    gguf_set_val_u32(gguf, key("block_count").c_str(),                    n_layer);
+    gguf_set_val_u32(gguf, key("attention.head_count").c_str(),           n_head);
+    gguf_set_val_u32(gguf, key("attention.head_count_kv").c_str(),        n_head_kv);
+    gguf_set_val_f32(gguf, key("attention.layer_norm_rms_epsilon").c_str(), 1e-6f);
+    gguf_set_val_f32(gguf, key("attention.layer_norm_epsilon").c_str(),     1e-5f);
+    gguf_set_val_f32(gguf, key("rope.freq_base").c_str(),                 10000.0f);
+    const uint32_t taps[] = { 1, 2 };
+    gguf_set_arr_data(gguf, key("tagger.tap_layers").c_str(), GGUF_TYPE_UINT32, taps, 2);
+    if (sliding_window) {
+        // a window shorter than the text: with it the encoder would stop seeing distant tokens
+        gguf_set_val_u32(gguf, key("attention.sliding_window").c_str(), 2);
+    }
+
+    ggml_init_params params = { 64 * 1024 * 1024, nullptr, false };
+    ggml_context * ctx = ggml_init(params);
+    std::mt19937 rng(42);
+    std::normal_distribution<float> dist(0.0f, 0.2f);
+    auto add = [&](const std::string & name, std::vector<int64_t> ne, bool ones = false) {
+        ggml_tensor * t = ne.size() == 1 ? ggml_new_tensor_1d(ctx, GGML_TYPE_F32, ne[0])
+                                         : ggml_new_tensor_2d(ctx, GGML_TYPE_F32, ne[0], ne[1]);
+        ggml_set_name(t, name.c_str());
+        float * data = (float *) t->data;
+        for (int64_t i = 0; i < ggml_nelements(t); ++i) {
+            data[i] = ones ? 1.0f : dist(rng);
+        }
+        gguf_add_tensor(gguf, t);
+    };
+
+    add("token_embd.weight",  {n_embd, n_vocab});
+    add("output_norm.weight", {n_embd}, true);
+    for (int il = 0; il < n_layer; ++il) {
+        const std::string p = "blk." + std::to_string(il) + ".";
+        add(p + "attn_norm.weight",   {n_embd}, true);
+        add(p + "attn_q.weight",      {n_embd, n_head * n_head_dim});
+        add(p + "attn_k.weight",      {n_embd, n_head_kv * n_head_dim});
+        add(p + "attn_v.weight",      {n_embd, n_head_kv * n_head_dim});
+        add(p + "attn_output.weight", {n_head * n_head_dim, n_embd});
+        add(p + "attn_q_norm.weight", {n_head_dim}, true);
+        add(p + "attn_k_norm.weight", {n_head_dim}, true);
+        add(p + "ffn_norm.weight",    {n_embd}, true);
+        add(p + "ffn_gate.weight",    {n_embd, n_ff});
+        add(p + "ffn_down.weight",    {n_ff, n_embd});
+        add(p + "ffn_up.weight",      {n_embd, n_ff});
+    }
+    add("tagger.fc1.weight", {n_embd * 2, n_hidden});
+    add("tagger.fc1.bias",   {n_hidden});
+    add("tagger.fc2.weight", {n_hidden, n_tags});
+    add("tagger.fc2.bias",   {n_tags});
+
+    CHECK(gguf_write_to_file(gguf, path.c_str(), false));
+    gguf_free(gguf);
+    ggml_free(ctx);
+}
+
+// tag logits of every token of a fixed text
+static std::vector<float> run(const std::string & path, int32_t & n_swa) {
+    llama_model * model = llama_model_load_from_file(path.c_str(), llama_model_default_params());
+    CHECK(model != nullptr);
+    n_swa = llama_model_n_swa(model);
+    CHECK(llama_model_n_embd_out(model) == n_tags);
+
+    auto cparams = llama_context_default_params();
+    cparams.n_ctx        = 64;
+    cparams.n_batch      = 16;
+    cparams.n_ubatch     = 16;
+    cparams.embeddings   = true;
+    cparams.pooling_type = LLAMA_POOLING_TYPE_NONE;
+    llama_context * ctx = llama_init_from_model(model, cparams);
+    CHECK(ctx != nullptr);
+
+    const int n_tokens = 12;
+    llama_batch batch = llama_batch_init(n_tokens, 0, 1);
+    for (int i = 0; i < n_tokens; ++i) {
+        batch.token[i] = (7 * i + 3) % n_vocab; batch.pos[i] = i; batch.n_seq_id[i] = 1; batch.seq_id[i][0] = 0; batch.logits[i] = true;
+    }
+    batch.n_tokens = n_tokens;
+    CHECK(llama_decode(ctx, batch) == 0);
+
+    std::vector<float> out;
+    for (int i = 0; i < n_tokens; ++i) {
+        const float * e = llama_get_embeddings_ith(ctx, i);
+        CHECK(e != nullptr);
+        for (int j = 0; j < n_tags; ++j) {
+            CHECK(std::isfinite(e[j]));
+            out.push_back(e[j]);
+        }
+    }
+    llama_batch_free(batch);
+    llama_free(ctx);
+    llama_model_free(model);
+    return out;
+}
+
+int main() {
+    try {
+        llama_log_set([](ggml_log_level, const char *, void *) {}, nullptr);
+        llama_backend_init();
+
+        const std::string plain = "test-span-tagger-plain.gguf", windowed = "test-span-tagger-window.gguf";
+        write_model(plain,    false);
+        write_model(windowed, true);
+
+        int32_t n_swa_plain = -1, n_swa_windowed = -1;
+        const auto tags_plain    = run(plain,    n_swa_plain);
+        const auto tags_windowed = run(windowed, n_swa_windowed);
+        std::remove(plain.c_str());
+        std::remove(windowed.c_str());
+
+        CHECK(n_swa_plain == 0);
+        CHECK(n_swa_windowed == 0);
+        CHECK(tags_plain.size() == tags_windowed.size());
+        CHECK(std::memcmp(tags_plain.data(), tags_windowed.data(), tags_plain.size() * sizeof(float)) == 0);
+
+        llama_backend_free();
+        std::printf("PASS: the sliding window key does not make span-tagger iSWA (%zu tag logits equal)\n", tags_plain.size());
+        return 0;
+    } catch (const std::exception & e) {
+        std::fprintf(stderr, "%s\n", e.what());
+        return 1;
+    }
+}
