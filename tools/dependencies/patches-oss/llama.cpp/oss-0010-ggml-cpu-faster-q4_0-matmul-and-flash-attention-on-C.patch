+static bool ggml_flash_attn_ext_group_ok(const ggml_compute_params * params, const ggml_tensor * dst) {
+#if !defined(__aarch64__) || defined(__ARM_FEATURE_SVE)
+    // bitwise equality with one_chunk is verified only on arm64 without SVE (A55, Apple); on x86 the result differs
+    GGML_UNUSED(params);
+    GGML_UNUSED(dst);
+    return false;
+#else
+    const ggml_tensor * q    = dst->src[0];
+    const ggml_tensor * k    = dst->src[1];
+    const ggml_tensor * v    = dst->src[2];
+    const ggml_tensor * mask = dst->src[3];
