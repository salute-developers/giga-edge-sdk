+// FA with the split_rows flag: each row of a batch is bitwise equal to the same row computed alone,
+// as in step-by-step generation (its own n_kv = PAD(last open cell + 1, 256), its own cache split).
+
+#include "ggml.h"
+#include "ggml-cpu.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <random>
+#include <vector>
+
+static constexpr int64_t D       = 128;
+static constexpr int64_t N_HEAD  = 10;
+static constexpr int64_t N_HEAD_KV = 2;
+
+static void compute(ggml_cgraph * gf, int n_threads) {
+    ggml_cplan plan = ggml_graph_plan(gf, n_threads, nullptr);
+    std::vector<uint8_t> work(plan.work_size);
+    plan.work_data = work.data();
+    ggml_graph_compute(gf, &plan);
+}
+
+// q: [D, rows, N_HEAD], k/v: [D, n_kv, N_HEAD_KV] (the first n_kv cache cells), mask: [n_kv, rows]
+static std::vector<float> attend(const std::vector<float> & q, const std::vector<ggml_fp16_t> & k, const std::vector<ggml_fp16_t> & v,
+        const std::vector<ggml_fp16_t> & mask, int64_t n_cells, int64_t n_kv, int64_t rows, bool split_rows, int n_threads) {
+    ggml_init_params params = { 64*1024*1024, nullptr, false };
+    ggml_context * ctx = ggml_init(params);
+
+    ggml_tensor * tq = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, D, rows, N_HEAD);
+    ggml_tensor * tk = ggml_new_tensor_3d(ctx, GGML_TYPE_F16, D, n_kv, N_HEAD_KV);
+    ggml_tensor * tv = ggml_new_tensor_3d(ctx, GGML_TYPE_F16, D, n_kv, N_HEAD_KV);
+    ggml_tensor * tm = ggml_new_tensor_2d(ctx, GGML_TYPE_F16, n_kv, rows);
+
+    memcpy(tq->data, q.data(), ggml_nbytes(tq));
+    for (int64_t h = 0; h < N_HEAD_KV; ++h) {
+        memcpy((char *) tk->data + h*tk->nb[2], k.data() + h*n_cells*D, n_kv*D*sizeof(ggml_fp16_t));
+        memcpy((char *) tv->data + h*tv->nb[2], v.data() + h*n_cells*D, n_kv*D*sizeof(ggml_fp16_t));
+    }
+    memcpy(tm->data, mask.data(), ggml_nbytes(tm));
+
+    ggml_tensor * out = ggml_flash_attn_ext(ctx, tq, tk, tv, tm, 1.0f/sqrtf((float) D), 0.0f, 0.0f);
+    ggml_prec_set_acc(out, GGML_PREC_F32);
+    ggml_flash_attn_ext_set_split_rows(out, split_rows);
+
+    ggml_cgraph * gf = ggml_new_graph(ctx);
+    ggml_build_forward_expand(gf, out);
+    compute(gf, n_threads);
+
+    std::vector<float> res(ggml_nelements(out));
+    memcpy(res.data(), out->data, ggml_nbytes(out));
+    ggml_free(ctx);
+    return res;
+}
+
+int main() {
+    std::mt19937 rng(42);
+    std::uniform_real_distribution<float> dist(-1.0f, 1.0f);
+
+    int n_cases = 0;
+    int n_failed = 0;
+
+    for (const int64_t n_cells : {512, 768, 1024}) {
+        std::vector<ggml_fp16_t> k(N_HEAD_KV*n_cells*D), v(N_HEAD_KV*n_cells*D);
+        for (auto & x : k) x = ggml_fp32_to_fp16(dist(rng));
+        for (auto & x : v) x = ggml_fp32_to_fp16(dist(rng));
+
+        for (const int64_t rows : {2, 3, 4, 8}) {
+            // the last row of the batch is on the last used cell; the first batch crosses the 256 boundary
+            for (const int64_t last : {n_cells - 1, n_cells - 200, 256 + rows / 2}) {
+                for (const int64_t window : {int64_t(0), int64_t(128)}) {
+                    for (const int n_threads : {1, 3, 4}) {
+                        std::vector<float> q(D*rows*N_HEAD);
+                        for (auto & x : q) x = dist(rng);
+
+                        // row i is on cell last-rows+1+i: it sees the cells up to itself (and not beyond the window)
+                        std::vector<ggml_fp16_t> mask(n_cells*rows, ggml_fp32_to_fp16(-INFINITY));
+                        for (int64_t i = 0; i < rows; ++i) {
+                            const int64_t cell = last - rows + 1 + i;
+                            for (int64_t c = window ? std::max<int64_t>(0, cell - window + 1) : 0; c <= cell; ++c) {
+                                mask[i*n_cells + c] = ggml_fp32_to_fp16(0.0f);
+                            }
+                        }
+
+                        const std::vector<float> batch = attend(q, k, v, mask, n_cells, n_cells, rows, true, n_threads);
+
+                        for (int64_t i = 0; i < rows; ++i) {
+                            const int64_t cell = last - rows + 1 + i;
+                            const int64_t n_kv = std::min<int64_t>(n_cells, std::max<int64_t>(256, GGML_PAD(cell + 1, 256)));
+
+                            std::vector<float> qi(D*N_HEAD);
+                            for (int64_t h = 0; h < N_HEAD; ++h) {
+                                memcpy(qi.data() + h*D, q.data() + (h*rows + i)*D, D*sizeof(float));
+                            }
+                            std::vector<ggml_fp16_t> mi(mask.begin() + i*n_cells, mask.begin() + i*n_cells + n_kv);
+
+                            const std::vector<float> single = attend(qi, k, v, mi, n_cells, n_kv, 1, false, n_threads);
+
+                            // FA output: [D, N_HEAD, rows]
+                            ++n_cases;
+                            if (memcmp(single.data(), batch.data() + i*N_HEAD*D, N_HEAD*D*sizeof(float)) != 0) {
+                                ++n_failed;
+                                fprintf(stderr, "mismatch: cells %lld rows %lld last %lld window %lld threads %d row %lld\n",
+                                        (long long) n_cells, (long long) rows, (long long) last, (long long) window, n_threads, (long long) i);
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    printf("%d/%d rows bit-identical\n", n_cases - n_failed, n_cases);
+    return n_failed == 0 ? 0 : 1;
+}
