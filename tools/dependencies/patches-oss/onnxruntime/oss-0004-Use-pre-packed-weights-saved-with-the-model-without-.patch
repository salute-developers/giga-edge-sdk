+#if defined(__linux__)
+bool IsWeightsMapping(const void* data) {
+  std::ifstream maps("/proc/self/maps");
+  std::string line;
+  const auto address = reinterpret_cast<uintptr_t>(data);
+  while (std::getline(maps, line)) {
+    unsigned long long start = 0, end = 0;
+    if (sscanf(line.c_str(), "%llx-%llx", &start, &end) == 2 && address >= start && address < end) {
+      return (line.find("weights.bin") != std::string::npos || line.find("model.onnx.data") != std::string::npos);
+    }
+  }
+  return false;
+}
+#endif
+
+struct MemoryBindings {
+  std::unordered_map<std::string, const void*> sources;
+  std::unordered_map<std::string, std::vector<const void*>> packed;
+};
+
+struct PackingCalls {
+  size_t prepack = 0;
+  size_t allocations = 0;
+};
+
+class PackingAllocator final : public IAllocator {
+ public:
+  PackingAllocator(AllocatorPtr allocator, PackingCalls& calls)
+      : IAllocator(allocator->Info()), allocator_(std::move(allocator)), calls_(calls) {}
+  void* Alloc(size_t size) override {
+    ++calls_.allocations;
+    return allocator_->Alloc(size);
+  }
+  void Free(void* p) override { allocator_->Free(p); }
+
+ private:
+  AllocatorPtr allocator_;
+  PackingCalls& calls_;
+};
+
+// Exercise the production kernel, counting calls and protecting its source mappings.
+class ObservedKernel final : public OpKernel {
+ public:
+  ObservedKernel(const OpKernelInfo& info, std::unique_ptr<OpKernel> kernel, PackingCalls& calls, bool protect_source,
+                 bool accepts_storage, const MemoryBindings* memory = nullptr)
+      : OpKernel(info), kernel_(std::move(kernel)), calls_(calls), accepts_storage_(accepts_storage), memory_(memory) {
+    for (int input = 0; input < static_cast<int>(Node().InputDefs().size()); ++input) {
+      if (GetPrePackedWeightsFormat(input).empty()) continue;
+      const Tensor* tensor = nullptr;
+      if (memory_ || protect_source) {
+        ORT_ENFORCE(info.TryGetConstantInput(input, &tensor));
+        if (memory_) {
+          ORT_ENFORCE(tensor->DataRaw() == memory_->sources.at(Node().InputDefs()[input]->Name()),
+                      "Source initializer was copied from the user buffer");
+        }
+      }
+#if !defined(_WIN32)
+      if (protect_source) {
+        const size_t page_size = static_cast<size_t>(sysconf(_SC_PAGESIZE));
+#if defined(__linux__)
+        ORT_ENFORCE(IsWeightsMapping(tensor->DataRaw()), "Source initializer was copied to the heap");
+#endif
+        const auto address = reinterpret_cast<uintptr_t>(tensor->DataRaw());
+        const auto start = address & ~(page_size - 1);
+        const auto length = ((address - start + tensor->SizeInBytes() + page_size - 1) / page_size) * page_size;
+        ORT_ENFORCE(mprotect(reinterpret_cast<void*>(start), length, PROT_NONE) == 0);
+      }
+#endif
+    }
+  }
+
+  Status Compute(OpKernelContext* context) const override { return kernel_->Compute(context); }
+  Status PrePack(const Tensor& tensor, int input, AllocatorPtr allocator, bool& packed,
+                 PrePackedWeights* weights) override {
+    if (!GetPrePackedWeightsFormat(input).empty()) ++calls_.prepack;
+    return kernel_->PrePack(tensor, input, std::make_shared<PackingAllocator>(allocator, calls_), packed, weights);
+  }
+  Status UseSharedPrePackedBuffers(std::vector<BufferUniquePtr>& buffers, int input, bool& used) override {
+    return kernel_->UseSharedPrePackedBuffers(buffers, input, used);
+  }
+  std::string GetPrePackedWeightsFormat(int input) const override { return kernel_->GetPrePackedWeightsFormat(input); }
+  Status AcceptPrePackedMetadata(const Tensor& tensor, int input, const PrePackedWeights& weights,
+                                 bool& used) override {
+    if (!accepts_storage_) return OpKernel::AcceptPrePackedMetadata(tensor, input, weights, used);
+    if (memory_) {
+      const auto& expected = memory_->packed.at(Node().InputDefs()[input]->Name());
+      ORT_ENFORCE(weights.buffers_.size() == expected.size());
+      for (size_t i = 0; i < expected.size(); ++i) {
+        ORT_ENFORCE(weights.buffers_[i].get() == expected[i], "Packed initializer was copied from the user buffer");
+      }
+    } else {
+#if defined(__linux__)
+      for (const auto& buffer : weights.buffers_) {
+        ORT_ENFORCE(IsWeightsMapping(buffer.get()), "Packed initializer was copied to the heap");
+      }
+#endif
+    }
+    return kernel_->AcceptPrePackedMetadata(tensor, input, weights, used);
+  }
+
+ private:
+  std::unique_ptr<OpKernel> kernel_;
+  PackingCalls& calls_;
+  bool accepts_storage_;
+  const MemoryBindings* memory_;
+};
