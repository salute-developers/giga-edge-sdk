+TEST(PrepackedFromStorageSharingTest, CallerOwnedBuffersStayInTheirGraph) {
+  for (bool saving : {false, true}) {
+    SCOPED_TRACE(saving);
+    PrepackedKeyToBlobMap blobs;
+    PrepackedWeightsForGraph graph{blobs, saving};
+    char memory[64]{};
+    PrePackedWeights borrowed;
+    borrowed.buffers_owned_externally_ = true;
+    borrowed.buffers_.emplace_back(memory, [](void*) {});
+    borrowed.buffer_sizes_.push_back(sizeof(memory));
+    graph.InsertPrepackedWeights("key", std::move(borrowed));
+    auto reference = graph.GetPrepackedWeights("key")->CreateReferringCopy();
+    EXPECT_TRUE(reference.buffers_owned_externally_);
+    PrepackedWeightsContainer shared;
+    EXPECT_FALSE(shared.WriteWeight("key", std::move(reference)));
+    EXPECT_EQ(shared.GetNumberOfElements(), 0U);
+    EXPECT_EQ(reference.buffers_[0].get(), memory);
+    PrePackedWeights regenerated;
+    regenerated.buffers_.push_back(
+        IAllocator::MakeUniquePtr<void>(std::make_shared<CPUAllocator>(), sizeof(memory), true));
+    regenerated.buffer_sizes_.push_back(sizeof(memory));
+    EXPECT_FALSE(graph.ReplaceWithReferenceIfSaving("B", "key", regenerated).has_value());
+    ASSERT_NE(graph.GetPrepackedWeights("key"), nullptr);
+    EXPECT_EQ(graph.GetPrepackedWeights("key")->buffers_[0].get(), memory);
+    EXPECT_EQ(graph.GetKeysForWeightForSaving("B") != nullptr, saving);
+    ASSERT_TRUE(shared.WriteWeight("key", std::move(regenerated)));
+    EXPECT_NE(shared.GetWeight("key").buffers_[0].get(), memory);
+    EXPECT_FALSE(shared.GetWeight("key").buffers_owned_externally_);
+  }
+}
