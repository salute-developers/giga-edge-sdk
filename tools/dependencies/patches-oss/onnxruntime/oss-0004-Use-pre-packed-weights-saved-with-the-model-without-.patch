+TEST_P(PrepackedFromStorageTest, ModelBytesAndExternalWeightsInMemory) {
+#if defined(_WIN32) || defined(DISABLE_EXTERNAL_INITIALIZERS)
+  GTEST_SKIP() << "Read-only mapping test requires POSIX external initializers";
+#else
+  const std::string op = GetParam();
+  if (!MlasGemmPackBFormat() ||
+      (op != "Gemm" && op != "GemmTransposed" && op != "LSTM" && !MlasGemmPackBFormat(false, true))) {
+    GTEST_SKIP() << "No serialized packing ABI for this platform";
+  }
+  TemporaryDirectory directory{ORT_TSTR("prepacked_from_memory_test")};
+  const auto model_path = directory.Path() + ORT_TSTR("/model.onnx");
+  const auto weights_path = directory.Path() + ORT_TSTR("/model.onnx.data");
+  SessionOptions options;
+  options.graph_optimization_level = TransformerLevel::Default;
+  options.intra_op_param.thread_pool_size = 1;
+  options.inter_op_param.thread_pool_size = 1;
+  options.optimized_model_filepath = model_path;
+  ASSERT_STATUS_OK(options.config_options.AddConfigEntry(kOrtSessionOptionsSavePrePackedConstantInitializers, "1"));
+  ASSERT_STATUS_OK(options.config_options.AddConfigEntry(kOrtSessionOptionsOptimizedModelExternalInitializersFileName,
+                                                         "model.onnx.data"));
+  // Leave the external initializer threshold at its default (1024 bytes).
+  InferenceSessionWrapper writer{options, GetEnvironment()};
+  const auto source_model = MakeModel(op, true).SerializeAsString();
+  ASSERT_STATUS_OK(writer.Load(source_model.data(), static_cast<int>(source_model.size())));
+  ASSERT_STATUS_OK(writer.Initialize());
+  ONNX_NAMESPACE::ModelProto saved;
+  {
+    std::ifstream stream(model_path, std::ios::binary);
+    ASSERT_TRUE(saved.ParseFromIstream(&stream));
+  }
+  std::string bytes;
+  {
+    std::ifstream stream(weights_path, std::ios::binary);
+    bytes.assign(std::istreambuf_iterator<char>(stream), {});
+  }
+  SessionOptions baseline_options;
+  baseline_options.graph_optimization_level = TransformerLevel::Default;
+  baseline_options.intra_op_param.thread_pool_size = 1;
+  baseline_options.inter_op_param.thread_pool_size = 1;
+  std::vector<OrtValue> expected;
+  {
+    InferenceSessionWrapper baseline{baseline_options, GetEnvironment()};
+    ASSERT_STATUS_OK(baseline.Load(model_path));
+    ASSERT_STATUS_OK(baseline.Initialize());
+    expected = RunStorageModel(baseline, op == "LSTM", op == "MatMulIntegerToFloat", true);
+  }
+  const auto* production_info = writer.GetSessionState().GetKernelCreateInfoMap().begin()->second.get();
+  int fd = -1;
+  ASSERT_STATUS_OK(Env::Default().FileOpenRd(weights_path, fd));
+  void* memory = mmap(nullptr, bytes.size(), PROT_READ, MAP_PRIVATE, fd, 0);
+  const auto close_status = Env::Default().FileClose(fd);
+  ASSERT_NE(memory, MAP_FAILED);
+  Env::MappedMemoryPtr mapped{static_cast<char*>(memory), [size = bytes.size()](void* p) { munmap(p, size); }};
+  ASSERT_STATUS_OK(close_status);
+  // All memory-backed readers must work without either model or weights on disk.
+  ASSERT_TRUE(std::filesystem::remove(weights_path));
+  ASSERT_TRUE(std::filesystem::remove(model_path));
+  auto read = [&](bool use_mmap, size_t shift, bool enabled, bool mismatch) {
+    SCOPED_TRACE(testing::Message() << "mmap=" << use_mmap << ", shift=" << shift << ", enabled=" << enabled
+                                    << ", mismatch=" << mismatch);
+    const bool expect_hit = enabled && !shift && !mismatch;
+    std::unique_ptr<void, decltype(&std::free)> allocation{nullptr, std::free};
+    if (!use_mmap) {
+      void* data = nullptr;
+      ASSERT_EQ(posix_memalign(&data, kAllocAlignment, bytes.size() + shift), 0);
+      allocation.reset(data);
+    }
+    char* buffer = use_mmap ? mapped.get() : static_cast<char*>(allocation.get()) + shift;
+    if (!use_mmap) memcpy(buffer, bytes.data(), bytes.size());
+    auto model = saved;
+    MemoryBindings bindings;
+    for (auto& tensor : *model.mutable_graph()->mutable_initializer()) {
+      if (tensor.data_location() != ONNX_NAMESPACE::TensorProto_DataLocation_EXTERNAL) continue;
+      std::unique_ptr<ExternalDataInfo> info;
+      ASSERT_STATUS_OK(ExternalDataInfo::Create(tensor.external_data(), info));
+      ASSERT_TRUE(info->HasPrepackedInfo());
+      const auto offset = info->GetOffset();
+      const auto length = info->GetLength();
+      bindings.sources[tensor.name()] = buffer + offset;
+      auto& packed = bindings.packed[tensor.name()];
+      for (const auto& [key, blobs] : info->TakePrepackedInfos()) {
+        ORT_UNUSED_PARAMETER(key);
+        for (const auto& blob : blobs) packed.push_back(buffer + std::get<0>(blob));
+      }
+      if (use_mmap) {
+        const auto page_size = static_cast<size_t>(sysconf(_SC_PAGESIZE));
+        ASSERT_EQ(reinterpret_cast<uintptr_t>(buffer + offset) % page_size, 0U);
+        ASSERT_EQ(length % page_size, 0U);
+        // Protect source pages before Load/Initialize, not just before the kernel hook.
+        ASSERT_EQ(mprotect(buffer + offset, length, expect_hit ? PROT_NONE : PROT_READ), 0);
+      }
+      if (mismatch) {
+        for (auto& entry : *tensor.mutable_external_data()) {
+          if (entry.key().rfind("prepacked_v2_", 0) == 0) entry.mutable_value()->at(0) = '0';
+        }
+      }
+    }
+    PackingCalls calls;
+    auto registry = std::make_shared<CustomRegistry>();
+    KernelCreateInfo info{
+        std::make_unique<KernelDef>(*production_info->kernel_def),
+        [&](FuncManager& manager, const OpKernelInfo& kernel_info, std::unique_ptr<OpKernel>& kernel) {
+          std::unique_ptr<OpKernel> production;
+          ORT_RETURN_IF_ERROR(production_info->kernel_create_func(manager, kernel_info, production));
+          kernel = std::make_unique<ObservedKernel>(kernel_info, std::move(production), calls, false, true, &bindings);
+          return Status::OK();
+        }};
+    ASSERT_STATUS_OK(registry->RegisterCustomKernel(info));
+    SessionOptions reader_options;
+    reader_options.graph_optimization_level = TransformerLevel::Default;
+    reader_options.intra_op_param.thread_pool_size = 1;
+    reader_options.inter_op_param.thread_pool_size = 1;
+    reader_options.enable_cpu_mem_arena = false;
+    if (enabled)
+      ASSERT_STATUS_OK(reader_options.config_options.AddConfigEntry(
+          kOrtSessionOptionsUsePrePackedConstantInitializersWithoutRepack, "1"));
+    const std::vector<PathString> names{ORT_TSTR("model.onnx.data")};
+    std::vector<std::pair<char*, const size_t>> buffers{{buffer, bytes.size()}};
+    ASSERT_STATUS_OK(reader_options.AddExternalInitializersFromFilesInMemory(names, buffers));
+    InferenceSessionWrapper reader{reader_options, GetEnvironment()};
+    ASSERT_STATUS_OK(reader.RegisterCustomRegistry(registry));
+    const auto serialized = model.SerializeAsString();
+    ASSERT_STATUS_OK(reader.Load(serialized.data(), static_cast<int>(serialized.size())));
+    ASSERT_STATUS_OK(reader.Initialize());
+    const size_t weights = op == "LSTM" ? 2 : 1;
+    EXPECT_EQ(calls.prepack, expect_hit ? 0 : weights);
+    if (expect_hit)
+      EXPECT_EQ(calls.allocations, 0U);
+    else
+      EXPECT_GT(calls.allocations, 0U);
+    EXPECT_EQ(reader.GetSessionState().GetUsedPrePackedWeightsFromStorageCounter(), expect_hit ? weights : 0);
+    const auto actual = RunStorageModel(reader, op == "LSTM", op == "MatMulIntegerToFloat", true);
+    ASSERT_EQ(actual.size(), expected.size());
+    for (size_t i = 0; i < expected.size(); ++i) {
+      const auto& a = expected[i].Get<Tensor>();
+      const auto& b = actual[i].Get<Tensor>();
+      ASSERT_EQ(a.Shape(), b.Shape());
+      ASSERT_EQ(a.SizeInBytes(), b.SizeInBytes());
+      EXPECT_EQ(memcmp(a.DataRaw(), b.DataRaw(), a.SizeInBytes()), 0);
+    }
+  };
+  read(true, 0, true, false);
+  read(true, 0, false, false);
+  read(true, 0, true, true);
+  read(false, 0, true, false);
+  read(false, 0, false, false);
+  read(false, sizeof(float), true, false);
+  read(false, 0, true, true);
+  // Reject packed ranges before turning their offsets into pointers.
+  for (bool bad_length : {false, true}) {
+    auto invalid = saved;
+    for (auto& tensor : *invalid.mutable_graph()->mutable_initializer()) {
+      for (auto& entry : *tensor.mutable_external_data()) {
+        if (entry.key().rfind("prepacked_", 0) != 0 || entry.key().rfind("prepacked_v2_", 0) == 0) continue;
+        auto value = entry.value();
+        const auto offset_start = value.find('|') + 1;
+        const auto separator = value.find(';', offset_start);
+        const auto end = value.find(';', separator + 1);
+        if (bad_length)
+          value.replace(separator + 1, end - separator - 1, std::to_string(bytes.size() + 1));
+        else
+          value.replace(offset_start, separator - offset_start, std::to_string(bytes.size() + 1));
+        entry.set_value(value);
+      }
+    }
+    SessionOptions invalid_options = baseline_options;
+    const std::vector<PathString> names{ORT_TSTR("model.onnx.data")};
+    std::vector<std::pair<char*, const size_t>> buffers{{mapped.get(), bytes.size()}};
+    ASSERT_STATUS_OK(invalid_options.AddExternalInitializersFromFilesInMemory(names, buffers));
+    InferenceSessionWrapper reader{invalid_options, GetEnvironment()};
+    const auto data = invalid.SerializeAsString();
+    auto status = reader.Load(data.data(), static_cast<int>(data.size()));
+    if (status.IsOK()) status = reader.Initialize();
+    ASSERT_FALSE(status.IsOK());
+    EXPECT_NE(status.ErrorMessage().find("Pre-packed blob"), std::string::npos);
+    EXPECT_NE(status.ErrorMessage().find("out of bounds"), std::string::npos);
+  }
+  // Missing files and a missing table entry must return a diagnostic Status.
+  const auto serialized = saved.SerializeAsString();
+  for (bool wrong_entry : {false, true}) {
+    SessionOptions missing_options = baseline_options;
+    ASSERT_STATUS_OK(missing_options.config_options.AddConfigEntry(
+        kOrtSessionOptionsUsePrePackedConstantInitializersWithoutRepack, "1"));
+    if (wrong_entry) {
+      const std::vector<PathString> names{ORT_TSTR("other.data")};
+      std::vector<std::pair<char*, const size_t>> buffers{{mapped.get(), bytes.size()}};
+      ASSERT_STATUS_OK(missing_options.AddExternalInitializersFromFilesInMemory(names, buffers));
+    }
+    InferenceSessionWrapper reader{missing_options, GetEnvironment()};
+    auto status = reader.Load(serialized.data(), static_cast<int>(serialized.size()));
+    if (status.IsOK()) status = reader.Initialize();
+    ASSERT_FALSE(status.IsOK());
+    EXPECT_NE(status.ErrorMessage().find("model.onnx.data"), std::string::npos);
+    EXPECT_EQ(status.ErrorMessage().find("filesystem error"), std::string::npos);
+  }
+#endif
+}
+
+TEST(PrepackedFromStorageOptimizerTest, BasicAndExtendedReadMemoryTaggedWeights) {
+#if defined(DISABLE_EXTERNAL_INITIALIZERS)
+  GTEST_SKIP();
+#else
+  TemporaryDirectory directory{ORT_TSTR("prepacked_optimizer_test")};
+  const auto model_path = directory.Path() + ORT_TSTR("/model.onnx");
+  const auto weights_path = directory.Path() + ORT_TSTR("/model.onnx.data");
+  auto model = MakeModel("MatMul", true);
+  auto& graph = *model.mutable_graph();
+  auto& b = *graph.mutable_initializer(0);
+  b.set_dims(1, 4);
+  b.mutable_raw_data()->resize(256 * 4 * sizeof(float));
+  graph.mutable_output(0)->mutable_type()->mutable_tensor_type()->mutable_shape()->mutable_dim(1)->set_dim_value(4);
+  graph.mutable_node(0)->set_output(0, "before_bn");
+  auto* bn = graph.add_node();
+  bn->set_name("batch_norm");
+  bn->set_op_type("BatchNormalization");
+  bn->add_input("before_bn");
+  bn->add_output("Y");
+  auto* epsilon = bn->add_attribute();
+  epsilon->set_name("epsilon");
+  epsilon->set_type(ONNX_NAMESPACE::AttributeProto_AttributeType_FLOAT);
+  epsilon->set_f(0.f);
+  for (const char* name : {"scale", "bias", "mean", "variance"}) {
+    auto* initializer = graph.add_initializer();
+    initializer->set_name(name);
+    initializer->set_data_type(ONNX_NAMESPACE::TensorProto_DataType_FLOAT);
+    initializer->add_dims(4);
+    const float value = std::string(name) == "scale" || std::string(name) == "variance" ? 1.f : 0.f;
+    for (int i = 0; i < 4; ++i) initializer->add_float_data(value);
+    bn->add_input(name);
+  }
+  SessionOptions options;
+  options.graph_optimization_level = TransformerLevel::Default;
+  options.intra_op_param.thread_pool_size = 1;
+  options.inter_op_param.thread_pool_size = 1;
+  options.optimized_model_filepath = model_path;
+  ASSERT_STATUS_OK(options.config_options.AddConfigEntry(kOrtSessionOptionsSavePrePackedConstantInitializers, "1"));
+  ASSERT_STATUS_OK(options.config_options.AddConfigEntry(kOrtSessionOptionsOptimizedModelExternalInitializersFileName,
+                                                         "model.onnx.data"));
+  const auto source = model.SerializeAsString();
+  InferenceSessionWrapper writer{options, GetEnvironment()};
+  ASSERT_STATUS_OK(writer.Load(source.data(), static_cast<int>(source.size())));
+  ASSERT_STATUS_OK(writer.Initialize());
+  const auto expected = RunStorageModel(writer, false, false, true);
+  ONNX_NAMESPACE::ModelProto saved;
+  {
+    std::ifstream stream(model_path, std::ios::binary);
+    ASSERT_TRUE(saved.ParseFromIstream(&stream));
+  }
+  bool has_packed_b = false;
+  for (const auto& initializer : saved.graph().initializer()) {
+    if (initializer.name() != "B") continue;
+    std::unique_ptr<ExternalDataInfo> info;
+    ASSERT_STATUS_OK(ExternalDataInfo::Create(initializer.external_data(), info));
+    has_packed_b = info->HasPrepackedInfo();
+  }
+  ASSERT_TRUE(has_packed_b);
+  std::string weights;
+  {
+    std::ifstream stream(weights_path, std::ios::binary);
+    weights.assign(std::istreambuf_iterator<char>(stream), {});
+  }
+  ASSERT_TRUE(std::filesystem::remove(model_path));
+  ASSERT_TRUE(std::filesystem::remove(weights_path));
+  const auto data = saved.SerializeAsString();
+  for (auto level : {TransformerLevel::Level1, TransformerLevel::Level2}) {
+    SCOPED_TRACE(static_cast<int>(level));
+    SessionOptions reader_options;
+    reader_options.graph_optimization_level = level;
+    reader_options.intra_op_param.thread_pool_size = 1;
+    reader_options.inter_op_param.thread_pool_size = 1;
+    ASSERT_STATUS_OK(reader_options.config_options.AddConfigEntry(
+        kOrtSessionOptionsUsePrePackedConstantInitializersWithoutRepack, "1"));
+    const std::vector<PathString> names{ORT_TSTR("model.onnx.data")};
+    std::vector<std::pair<char*, const size_t>> buffers{{weights.data(), weights.size()}};
+    ASSERT_STATUS_OK(reader_options.AddExternalInitializersFromFilesInMemory(names, buffers));
+    InferenceSessionWrapper reader{reader_options, GetEnvironment()};
+    ASSERT_STATUS_OK(reader.Load(data.data(), static_cast<int>(data.size())));
+    ASSERT_TRUE(reader.GetGraph().ModelPath().empty());
+    ASSERT_STATUS_OK(reader.Initialize());
+    bool has_gemm = false;
+    for (const auto& node : reader.GetGraph().Nodes()) {
+      EXPECT_NE(node.OpType(), "BatchNormalization");
+      has_gemm |= node.OpType() == "Gemm" || node.OpType() == "FusedGemm";
+    }
+    EXPECT_TRUE(has_gemm);
+    const auto actual = RunStorageModel(reader, false, false, true);
+    const auto& a = expected[0].Get<Tensor>();
+    const auto& result = actual[0].Get<Tensor>();
+    ASSERT_EQ(a.Shape(), result.Shape());
+    ASSERT_EQ(a.SizeInBytes(), result.SizeInBytes());
+    EXPECT_EQ(memcmp(a.DataRaw(), result.DataRaw(), a.SizeInBytes()), 0);
+  }
+#endif
+}
