+static bool PrepackedBuffersMatch(const PrePackedWeights& disk_weights, const PrePackedWeights& generated_weights) {
+  if (disk_weights.buffer_sizes_ != generated_weights.buffer_sizes_) return false;
+  const auto alignment = MlasGetPreferredBufferAlignment();
+  return std::all_of(disk_weights.buffers_.begin(), disk_weights.buffers_.end(), [alignment](const auto& buffer) {
+    return reinterpret_cast<uintptr_t>(buffer.get()) % alignment == 0;
+  });
+}
+
+static std::string GenerateKeyForPrepackedWeights(const std::string& op_type,
+                                                 const PrePackedWeights& weights,
+                                                 PrepackedWeightsForGraph& prepacked_for_graph,
+                                                 const std::string& input_name,
+                                                 const std::string& storage_key) {
+  auto key = GenerateKeyForPrepackedWeightsMap(op_type, weights);
+  const auto* disk_weights = prepacked_for_graph.GetPrepackedWeights(key);
+  if (disk_weights && !PrepackedBuffersMatch(*disk_weights, weights)) {
+    key += ":repacked";
+  }
+  if (!storage_key.empty() && prepacked_for_graph.IsSaveModeOn()) {
+    prepacked_for_graph.AddStorageKey(input_name, storage_key, key);
+  }
+  return key;
+}
+
+// Length-prefixed fields and hex encoding avoid delimiters in node names and attributes.
+static std::string MakePrepackedStorageKey(const OpKernel& kernel, const Tensor& tensor, int input_idx) {
+#if !defined(ORT_MINIMAL_BUILD)
+  const auto format = kernel.GetPrePackedWeightsFormat(input_idx);
+  if (format.empty()) return {};
+  const auto& node = kernel.Node();
+  std::string description;
+  auto append = [&description](const std::string& field) {
+    description += std::to_string(field.size()) + ":" + field;
+  };
+  append("ort-prepacked-v2");
+  append(node.OpType());
+  append(node.Domain());
+  append(std::to_string(node.SinceVersion()));
+  append(node.Name());
+  append(std::to_string(input_idx));
+  append(std::to_string(tensor.GetElementType()));
+  append(std::to_string(tensor.Shape().NumDimensions()));
+  for (auto dim : tensor.Shape().GetDims()) append(std::to_string(dim));
+  append(format);
+  std::vector<std::string> attributes;
+  for (const auto& attribute : node.GetAttributes()) attributes.push_back(attribute.first);
+  std::sort(attributes.begin(), attributes.end());
+  for (const auto& name : attributes) {
+    append(name);
+    append(node.GetAttributes().at(name).SerializeAsString());
+  }
+  constexpr char hex[] = "0123456789abcdef";
+  std::string key;
+  key.reserve(description.size() * 2);
+  for (unsigned char ch : description) {
+    key += hex[ch >> 4];
+    key += hex[ch & 15];
+  }
+  return key;
+#else
+  ORT_UNUSED_PARAMETER(kernel);
+  ORT_UNUSED_PARAMETER(tensor);
+  ORT_UNUSED_PARAMETER(input_idx);
+  return {};
+#endif
+}
