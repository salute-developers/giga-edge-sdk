+class PrepackedFromStorageTest : public testing::TestWithParam<const char*> {};
+
+TEST_P(PrepackedFromStorageTest, RoundTripAndFallback) {
+  const std::string op = GetParam();
+  if (!MlasGemmPackBFormat() ||
+      (op != "Gemm" && op != "GemmTransposed" && op != "LSTM" && !MlasGemmPackBFormat(false, true))) {
+    GTEST_SKIP() << "No serialized packing ABI for this platform";
+  }
+  TemporaryDirectory directory{ORT_TSTR("prepacked_from_storage_test")};
+  const auto model_path = directory.Path() + ORT_TSTR("/model.onnx");
+  SessionOptions options;
+  options.graph_optimization_level = TransformerLevel::Default;
+  options.intra_op_param.thread_pool_size = 1;
+  options.inter_op_param.thread_pool_size = 1;
+  options.enable_cpu_mem_arena = false;
+  options.optimized_model_filepath = model_path;
+  ASSERT_STATUS_OK(options.config_options.AddConfigEntry(kOrtSessionOptionsSavePrePackedConstantInitializers, "1"));
+  ASSERT_STATUS_OK(options.config_options.AddConfigEntry(kOrtSessionOptionsOptimizedModelExternalInitializersFileName,
+                                                         "weights.bin"));
+  ASSERT_STATUS_OK(
+      options.config_options.AddConfigEntry(kOrtSessionOptionsOptimizedModelExternalInitializersMinSizeInBytes, "0"));
+  InferenceSessionWrapper writer{options, GetEnvironment()};
+  const auto serialized = MakeModel(op).SerializeAsString();
+  ASSERT_STATUS_OK(writer.Load(serialized.data(), static_cast<int>(serialized.size())));
+  ASSERT_STATUS_OK(writer.Initialize());
+  const size_t expected_prepacks = op == "LSTM" ? 2 : 1;
+  ASSERT_EQ(writer.GetSessionState().GetNumberOfPrepacksCounter(), expected_prepacks);
+  const auto expected = RunStorageModel(writer, op == "LSTM", op == "MatMulIntegerToFloat");
+  const auto* production_info = writer.GetSessionState().GetKernelCreateInfoMap().begin()->second.get();
+  ONNX_NAMESPACE::ModelProto saved;
+  {
+    std::ifstream stream(model_path, std::ios::binary);
+    ASSERT_TRUE(saved.ParseFromIstream(&stream));
+  }
+
+  // Each reader uses the same production kernel with a test-only observer.
+  auto load = [&](ONNX_NAMESPACE::ModelProto model, bool enabled, bool protect, bool expect_hit,
+                  bool accepts_storage = true) {
+    {
+      std::ofstream stream(model_path, std::ios::binary);
+      ASSERT_TRUE(model.SerializeToOstream(&stream));
+    }
+    PackingCalls calls;
+    auto registry = std::make_shared<CustomRegistry>();
+    KernelCreateInfo info{std::make_unique<KernelDef>(*production_info->kernel_def),
+                          [&, protect, accepts_storage](FuncManager& manager, const OpKernelInfo& kernel_info,
+                                                        std::unique_ptr<OpKernel>& kernel) {
+                            std::unique_ptr<OpKernel> production;
+                            ORT_RETURN_IF_ERROR(production_info->kernel_create_func(manager, kernel_info, production));
+                            kernel = std::make_unique<ObservedKernel>(kernel_info, std::move(production), calls,
+                                                                      protect, accepts_storage);
+                            return Status::OK();
+                          }};
+    ASSERT_STATUS_OK(registry->RegisterCustomKernel(info));
+    SessionOptions reader_options;
+    reader_options.graph_optimization_level = TransformerLevel::Default;
+    reader_options.intra_op_param.thread_pool_size = 1;
+    reader_options.inter_op_param.thread_pool_size = 1;
+    reader_options.enable_cpu_mem_arena = false;
+    if (enabled)
+      ASSERT_STATUS_OK(reader_options.config_options.AddConfigEntry(
+          kOrtSessionOptionsUsePrePackedConstantInitializersWithoutRepack, "1"));
+    InferenceSessionWrapper reader{reader_options, GetEnvironment()};
+    ASSERT_STATUS_OK(reader.RegisterCustomRegistry(registry));
+    ASSERT_STATUS_OK(reader.Load(model_path));
+    ASSERT_STATUS_OK(reader.Initialize());
+    EXPECT_EQ(calls.prepack, expect_hit ? 0 : expected_prepacks);
+    if (expect_hit)
+      EXPECT_EQ(calls.allocations, 0U);
+    else
+      EXPECT_GT(calls.allocations, 0U);
+    EXPECT_EQ(reader.GetSessionState().GetUsedPrePackedWeightsFromStorageCounter(), expect_hit ? expected_prepacks : 0);
+    const auto actual = RunStorageModel(reader, op == "LSTM", op == "MatMulIntegerToFloat");
+    ASSERT_EQ(expected.size(), actual.size());
+    for (size_t i = 0; i < expected.size(); ++i) {
+      const auto& a = expected[i].Get<Tensor>();
+      const auto& b = actual[i].Get<Tensor>();
+      ASSERT_EQ(a.Shape(), b.Shape());
+      ASSERT_EQ(a.SizeInBytes(), b.SizeInBytes());
+      EXPECT_EQ(memcmp(a.DataRaw(), b.DataRaw(), a.SizeInBytes()), 0);
+    }
+  };
+  load(saved, false, false, false);
+  load(saved, true, true, true);
+  load(saved, true, false, false, false);
+  {
+    SessionOptions disabled;
+    disabled.graph_optimization_level = TransformerLevel::Default;
+    disabled.intra_op_param.thread_pool_size = 1;
+    disabled.inter_op_param.thread_pool_size = 1;
+    ASSERT_STATUS_OK(disabled.config_options.AddConfigEntry(kOrtSessionOptionsConfigDisablePrepacking, "1"));
+    ASSERT_STATUS_OK(
+        disabled.config_options.AddConfigEntry(kOrtSessionOptionsUsePrePackedConstantInitializersWithoutRepack, "1"));
+    InferenceSessionWrapper reader{disabled, GetEnvironment()};
+    ASSERT_STATUS_OK(reader.Load(model_path));
+    ASSERT_STATUS_OK(reader.Initialize());
+    EXPECT_EQ(reader.GetSessionState().GetUsedPrePackedWeightsFromStorageCounter(), 0U);
+  }
+  auto legacy = saved;
+  for (auto& tensor : *legacy.mutable_graph()->mutable_initializer()) {
+    auto* entries = tensor.mutable_external_data();
+    for (int i = entries->size() - 1; i >= 0; --i) {
+      if (entries->Get(i).key().rfind("prepacked_v2_", 0) == 0) entries->DeleteSubrange(i, 1);
+    }
+  }
+  load(legacy, true, false, false);
+  auto wrong_hash = saved;
+  for (auto& tensor : *wrong_hash.mutable_graph()->mutable_initializer()) {
+    for (auto& entry : *tensor.mutable_external_data()) {
+      if (entry.key().rfind("prepacked_", 0) != 0 || entry.key().rfind("prepacked_v2_", 0) == 0) continue;
+      entry.set_value("mismatched+hash" + entry.value().substr(entry.value().find('|')));
+    }
+  }
+  load(wrong_hash, true, false, false);
+  auto unaligned = saved;
+  for (auto& tensor : *unaligned.mutable_graph()->mutable_initializer()) {
+    for (auto& entry : *tensor.mutable_external_data()) {
+      if (entry.key().rfind("prepacked_", 0) != 0 || entry.key().rfind("prepacked_v2_", 0) == 0) continue;
+      auto value = entry.value();
+      const auto start = value.find('|') + 1;
+      const auto end = value.find(';', start);
+      const auto offset = std::stoll(value.substr(start, end - start));
+      ASSERT_GT(offset, 0);
+      value.replace(start, end - start, std::to_string(offset - 1));
+      entry.set_value(value);
+    }
+  }
+  load(unaligned, true, false, false);
+  load(unaligned, false, false, false);
+  // Fields: version, op, domain, since-version, name, input, dtype, rank, dimensions, format.
+  for (size_t field : {size_t{0}, size_t{1}, size_t{3}, size_t{4}, size_t{5}, size_t{6}, size_t{8},
+                       op == "LSTM" ? size_t{11} : size_t{10}}) {
+    auto mismatched = saved;
+    for (auto& tensor : *mismatched.mutable_graph()->mutable_initializer()) {
+      for (auto& entry : *tensor.mutable_external_data()) {
+        if (entry.key().rfind("prepacked_v2_", 0) != 0) continue;
+        const auto separator = entry.value().find(':');
+        std::string description;
+        for (size_t i = 0; i < separator; i += 2) {
+          description += static_cast<char>(std::stoul(entry.value().substr(i, 2), nullptr, 16));
+        }
+        size_t position = 0;
+        for (size_t i = 0; i <= field; ++i) {
+          const auto colon = description.find(':', position);
+          const auto length = std::stoul(description.substr(position, colon - position));
+          position = colon + 1;
+          if (i == field) break;
+          position += length;
+        }
+        // Corrupt one field without changing the blob key or the legacy record.
+        entry.mutable_value()->at(position * 2) = entry.value()[position * 2] == '0' ? '1' : '0';
+      }
+    }
+    SCOPED_TRACE(field);
+    load(mismatched, true, false, false);
+  }
+  auto malformed = saved;
+  for (auto& tensor : *malformed.mutable_graph()->mutable_initializer()) {
+    for (auto& entry : *tensor.mutable_external_data()) {
+      if (entry.key().rfind("prepacked_v2_", 0) == 0) entry.set_value("invalid metadata");
+    }
+  }
+  load(malformed, true, false, false);
+  auto short_blob = saved;
+  for (auto& tensor : *short_blob.mutable_graph()->mutable_initializer()) {
+    for (auto& entry : *tensor.mutable_external_data()) {
+      if (entry.key().rfind("prepacked_", 0) != 0 || entry.key().rfind("prepacked_v2_", 0) == 0) continue;
+      auto value = entry.value();
+      const auto start = value.find(';');
+      const auto end = value.find(';', start + 1);
+      ASSERT_NE(start, std::string::npos);
+      ASSERT_NE(end, std::string::npos);
+      value.replace(start + 1, end - start - 1, "1");
+      entry.set_value(value);
+    }
+  }
+  load(short_blob, true, false, false);
+  for (const char* invalid_range : {"-1;1;0", "not-a-number;1;0"}) {
+    auto invalid = saved;
+    for (auto& tensor : *invalid.mutable_graph()->mutable_initializer()) {
+      for (auto& entry : *tensor.mutable_external_data()) {
+        if (entry.key().rfind("prepacked_", 0) != 0 || entry.key().rfind("prepacked_v2_", 0) == 0) continue;
+        entry.set_value(entry.value().substr(0, entry.value().find('|') + 1) + invalid_range);
+      }
+    }
+    {
+      std::ofstream stream(model_path, std::ios::binary);
+      ASSERT_TRUE(invalid.SerializeToOstream(&stream));
+    }
+    SessionOptions invalid_options;
+    invalid_options.graph_optimization_level = TransformerLevel::Default;
+    invalid_options.intra_op_param.thread_pool_size = 1;
+    invalid_options.inter_op_param.thread_pool_size = 1;
+    ASSERT_STATUS_OK(invalid_options.config_options.AddConfigEntry(
+        kOrtSessionOptionsUsePrePackedConstantInitializersWithoutRepack, "1"));
+    InferenceSessionWrapper reader{invalid_options, GetEnvironment()};
+    auto status = reader.Load(model_path);
+    if (status.IsOK()) status = reader.Initialize();
+    EXPECT_FALSE(status.IsOK());
+  }
+}
