+ONNX_NAMESPACE::ModelProto MakeModel(const std::string& op, bool large = false) {
+  ONNX_NAMESPACE::ModelProto model;
+  model.set_ir_version(10);
+  auto* opset = model.add_opset_import();
+  opset->set_domain("");
+  opset->set_version(14);
+  const bool quantized = op == "DynamicQuantizeMatMul" || op == "MatMulIntegerToFloat";
+  if (quantized) {
+    opset = model.add_opset_import();
+    opset->set_domain(kMSDomain);
+    opset->set_version(1);
+  }
+  auto& graph = *model.mutable_graph();
+  graph.set_name("prepacked_storage");
+  auto add_value = [](auto* value, const char* name, int type, std::initializer_list<int64_t> dims) {
+    value->set_name(name);
+    auto* tensor = value->mutable_type()->mutable_tensor_type();
+    tensor->set_elem_type(type);
+    for (auto dim : dims) tensor->mutable_shape()->add_dim()->set_dim_value(dim);
+  };
+  const bool lstm = op == "LSTM";
+  const bool integer_input = op == "MatMulIntegerToFloat";
+  const int float_type = ONNX_NAMESPACE::TensorProto_DataType_FLOAT;
+  // Large weights occupy whole pages on hosts with 4K, 16K, or 64K pages.
+  const int64_t K = large ? 256 : 3;
+  const int64_t N = large ? 256 : 4;
+  const int64_t hidden_size = large ? 64 : 2;
+  add_value(graph.add_input(), "X", integer_input ? ONNX_NAMESPACE::TensorProto_DataType_UINT8 : float_type,
+            lstm ? std::initializer_list<int64_t>{2, 1, K} : std::initializer_list<int64_t>{2, K});
+  if (lstm) {
+    add_value(graph.add_output(), "Y_h", float_type, {2, 1, hidden_size});
+    add_value(graph.add_output(), "Y_c", float_type, {2, 1, hidden_size});
+  }
+  add_value(graph.add_output(), "Y", float_type,
+            lstm ? std::initializer_list<int64_t>{2, 2, 1, hidden_size} : std::initializer_list<int64_t>{2, N});
+  auto* node = graph.add_node();
+  node->set_name("weight_node:|;\xD1\x83");
+  node->set_op_type(op == "GemmTransposed" ? "Gemm" : op);
+  node->set_domain(quantized ? kMSDomain : "");
+  node->add_input("X");
+  node->add_output("Y");
+  if (lstm) {
+    node->add_output("Y_h");
+    node->add_output("Y_c");
+  }
+  auto add_weight = [&](const char* name, std::initializer_list<int64_t> dims, bool int8) {
+    auto* tensor = graph.add_initializer();
+    tensor->set_name(name);
+    tensor->set_data_type(int8 ? ONNX_NAMESPACE::TensorProto_DataType_INT8 : float_type);
+    size_t count = 1;
+    for (auto dim : dims) {
+      tensor->add_dims(dim);
+      count *= static_cast<size_t>(dim);
+    }
+    if (int8) {
+      std::string data(count, '\0');
+      for (size_t i = 0; i < count; ++i) data[i] = static_cast<char>(static_cast<int>(i % 19) - 9);
+      tensor->set_raw_data(data);
+    } else {
+      std::vector<float> data(count);
+      for (size_t i = 0; i < count; ++i) data[i] = static_cast<float>(static_cast<int>(i % 17) - 8) / 16;
+      tensor->set_raw_data(data.data(), data.size() * sizeof(float));
+    }
+    node->add_input(name);
+  };
+  if (lstm) {
+    add_weight("W", {2, 4 * hidden_size, K}, false);
+    add_weight("R", {2, 4 * hidden_size, hidden_size}, false);
+    auto* hidden = node->add_attribute();
+    hidden->set_name("hidden_size");
+    hidden->set_type(ONNX_NAMESPACE::AttributeProto_AttributeType_INT);
+    hidden->set_i(hidden_size);
+    auto* direction = node->add_attribute();
+    direction->set_name("direction");
+    direction->set_type(ONNX_NAMESPACE::AttributeProto_AttributeType_STRING);
+    direction->set_s("bidirectional");
+  } else {
+    if (op == "GemmTransposed") {
+      add_weight("B", {N, K}, false);
+      auto* transpose = node->add_attribute();
+      transpose->set_name("transB");
+      transpose->set_type(ONNX_NAMESPACE::AttributeProto_AttributeType_INT);
+      transpose->set_i(1);
+    } else {
+      add_weight("B", {K, N}, quantized);
+    }
+    if (quantized) {
+      auto add_scale = [&](const char* name) {
+        auto* tensor = graph.add_initializer();
+        tensor->set_name(name);
+        tensor->set_data_type(float_type);
+        tensor->add_float_data(0.125f);
+        node->add_input(name);
+      };
+      if (integer_input) add_scale("a_scale");
+      add_scale("b_scale");
+    }
+  }
+  return model;
+}
+
+std::vector<OrtValue> RunStorageModel(InferenceSessionWrapper& session, bool lstm, bool integer_input,
+                                      bool large = false, bool shared_output = false) {
+  auto allocator = std::make_shared<CPUAllocator>();
+  OrtValue input;
+  const int64_t K = large ? 256 : 3;
+  Tensor::InitOrtValue(integer_input ? DataTypeImpl::GetType<uint8_t>() : DataTypeImpl::GetType<float>(),
+                       TensorShape(lstm ? std::vector<int64_t>{2, 1, K} : std::vector<int64_t>{2, K}), allocator,
+                       input);
+  if (integer_input) {
+    for (size_t i = 0; i < static_cast<size_t>(2 * K); ++i)
+      input.GetMutable<Tensor>()->MutableData<uint8_t>()[i] = static_cast<uint8_t>(i + 1);
+  } else {
+    for (size_t i = 0; i < static_cast<size_t>(2 * K); ++i)
+      input.GetMutable<Tensor>()->MutableData<float>()[i] = static_cast<float>(i + 1) / 8;
+  }
+  std::vector<OrtValue> outputs;
+  std::vector<std::string> output_names =
+      lstm ? std::vector<std::string>{"Y", "Y_h", "Y_c"} : std::vector<std::string>{"Y"};
+  if (shared_output) output_names.push_back("Y_shared");
+  ORT_THROW_IF_ERROR(session.Run(RunOptions{}, {{"X", input}}, output_names, &outputs));
+  return outputs;
+}
