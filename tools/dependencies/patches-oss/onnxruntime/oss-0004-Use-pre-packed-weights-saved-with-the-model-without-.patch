+TEST(PrepackedFromStorageSharingTest, SharedContainerOutlivesUserMemory) {
+#if defined(_WIN32) || defined(DISABLE_EXTERNAL_INITIALIZERS)
+  GTEST_SKIP();
+#else
+  TemporaryDirectory directory{ORT_TSTR("prepacked_sharing_test")};
+  const auto model_path = directory.Path() + ORT_TSTR("/model.onnx");
+  const auto weights_path = directory.Path() + ORT_TSTR("/model.onnx.data");
+  auto model = MakeModel("Gemm", true);
+  auto& graph = *model.mutable_graph();
+  auto* other_b = graph.add_initializer();
+  *other_b = graph.initializer(0);
+  other_b->set_name("B_shared");
+  // Avoid initializer deduplication; AddInitializer will override this value in the readers.
+  other_b->mutable_raw_data()->assign(other_b->raw_data().size(), '\0');
+  auto* other_node = graph.add_node();
+  *other_node = graph.node(0);
+  other_node->set_name("shared_node");
+  other_node->set_input(1, "B_shared");
+  other_node->set_output(0, "Y_shared");
+  auto* other_output = graph.add_output();
+  *other_output = graph.output(0);
+  other_output->set_name("Y_shared");
+  std::vector<float> shared_values(graph.initializer(0).raw_data().size() / sizeof(float));
+  memcpy(shared_values.data(), graph.initializer(0).raw_data().data(), graph.initializer(0).raw_data().size());
+  OrtValue shared_initializer;
+  Tensor shared_tensor{DataTypeImpl::GetType<float>(), TensorShape({256, 256}), shared_values.data(),
+                       OrtMemoryInfo(CPU, OrtDeviceAllocator)};
+  Tensor::InitOrtValue(std::move(shared_tensor), shared_initializer);
+  SessionOptions options;
+  options.graph_optimization_level = TransformerLevel::Default;
+  options.intra_op_param.thread_pool_size = 1;
+  options.inter_op_param.thread_pool_size = 1;
+  options.optimized_model_filepath = model_path;
+  ASSERT_STATUS_OK(options.config_options.AddConfigEntry(kOrtSessionOptionsSavePrePackedConstantInitializers, "1"));
+  ASSERT_STATUS_OK(options.config_options.AddConfigEntry(kOrtSessionOptionsOptimizedModelExternalInitializersFileName,
+                                                         "model.onnx.data"));
+  const auto source = model.SerializeAsString();
+  InferenceSessionWrapper writer{options, GetEnvironment()};
+  ASSERT_STATUS_OK(writer.Load(source.data(), static_cast<int>(source.size())));
+  ASSERT_STATUS_OK(writer.Initialize());
+  const auto expected = RunStorageModel(writer, false, false, true);
+  std::string data, weights;
+  {
+    std::ifstream stream(model_path, std::ios::binary);
+    data.assign(std::istreambuf_iterator<char>(stream), {});
+  }
+  {
+    std::ifstream stream(weights_path, std::ios::binary);
+    weights.assign(std::istreambuf_iterator<char>(stream), {});
+  }
+  ASSERT_TRUE(std::filesystem::remove(model_path));
+  ASSERT_TRUE(std::filesystem::remove(weights_path));
+  auto allocate_buffer = [&]() -> Env::MappedMemoryPtr {
+    void* memory = mmap(nullptr, weights.size(), PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    ORT_ENFORCE(memory != MAP_FAILED);
+    Env::MappedMemoryPtr buffer{static_cast<char*>(memory), [size = weights.size()](void* p) { munmap(p, size); }};
+    memcpy(memory, weights.data(), weights.size());
+    ORT_ENFORCE(mprotect(memory, weights.size(), PROT_READ) == 0);
+    return buffer;
+  };
+  for (bool enabled : {false, true}) {
+    SCOPED_TRACE(enabled);
+    PrepackedWeightsContainer container;
+    auto first_buffer = allocate_buffer();
+    auto read = [&](char* buffer, bool cached) {
+      SessionOptions reader_options;
+      reader_options.graph_optimization_level = TransformerLevel::Default;
+      reader_options.intra_op_param.thread_pool_size = 1;
+      reader_options.inter_op_param.thread_pool_size = 1;
+      ASSERT_STATUS_OK(reader_options.config_options.AddConfigEntry(
+          kOrtSessionOptionsUsePrePackedConstantInitializersWithoutRepack, enabled ? "1" : "0"));
+      ASSERT_STATUS_OK(reader_options.AddInitializer("B_shared", &shared_initializer));
+      const std::vector<PathString> names{ORT_TSTR("model.onnx.data")};
+      std::vector<std::pair<char*, const size_t>> buffers{{buffer, weights.size()}};
+      ASSERT_STATUS_OK(reader_options.AddExternalInitializersFromFilesInMemory(names, buffers));
+      InferenceSessionWrapper reader{reader_options, GetEnvironment()};
+      ASSERT_STATUS_OK(reader.AddPrePackedWeightsContainer(&container));
+      ASSERT_STATUS_OK(reader.Load(data.data(), static_cast<int>(data.size())));
+      ASSERT_STATUS_OK(reader.Initialize());
+      EXPECT_EQ(reader.GetSessionState().GetUsedSharedPrePackedWeightCounter(), cached ? 1U : 0U);
+      const auto actual = RunStorageModel(reader, false, false, true, true);
+      ASSERT_EQ(actual.size(), 2U);
+      const auto& a = expected[0].Get<Tensor>();
+      for (const auto& output : actual) {
+        const auto& result = output.Get<Tensor>();
+        ASSERT_EQ(a.Shape(), result.Shape());
+        ASSERT_EQ(a.SizeInBytes(), result.SizeInBytes());
+        EXPECT_EQ(memcmp(a.DataRaw(), result.DataRaw(), a.SizeInBytes()), 0);
+      }
+      ASSERT_EQ(container.GetNumberOfElements(), 1U);
+      for (const auto& [key, packed] : container.prepacked_weights_map_) {
+        ORT_UNUSED_PARAMETER(key);
+        EXPECT_FALSE(packed.buffers_owned_externally_);
+        for (const auto& owned : packed.buffers_) {
+          const auto address = reinterpret_cast<uintptr_t>(owned.get());
+          const auto start = reinterpret_cast<uintptr_t>(buffer);
+          ASSERT_TRUE(address < start || address >= start + weights.size());
+        }
+      }
+    };
+    read(first_buffer.get(), false);
+    // Keep the old addresses reserved and inaccessible so stale pointers cannot pass by address reuse.
+    ASSERT_EQ(mprotect(first_buffer.get(), weights.size(), PROT_NONE), 0);
+    auto second_buffer = allocate_buffer();
+    read(second_buffer.get(), true);
+  }
+#endif
+}
